# hookprobe-ptp4l.service — base-tier-build-ticket.md Phase 3 (PTP time-truth, userspace).
# Disciplines the Phase-0 macb PHC (`/sys/class/ptp/ptp0`, IEEE-1588 hardware timestamping on
# the GEM instance behind RP1 — CONFIG_PTP_1588_CLOCK, builder/build-edge-kernel.sh) via the
# standard `linuxptp` Precision Time Protocol daemon, participating in the Best Master Clock
# Algorithm (BMCA) on a HookProbe-private PTP domain. No `-f` config file is shipped: every
# tunable below is a documented long-option on the command line (linuxptp(8): "Each and every
# configuration file option may also appear as a long command line argument") — this keeps the
# unit fully self-contained under base/units/ with no extra base/config/ drop-in to stage, wire
# into the Containerfile/mkosi COPY lists, or drift out of sync with it.
#
# --- MESH HONESTY (base-tier-build-ticket.md Phase 3 acceptance gate, do not weaken this) -----
# Hardware timestamps from THIS node's macb TSU are locally precise (sub-microsecond intra-node
# event ordering — NAPSE kill-chain sequencing). Cross-node absolute time alignment across a
# HookProbe mesh additionally needs a PTP domain WITH A MASTER: there is no GNSS grandmaster on
# a $50 stock Pi 5/CM5 (zero-BOM, ADR 0031 scope). With no dedicated grandmaster, ptp4l's BMCA
# lets any uncontested mesh node self-elect as the domain's master (default priority1/2=128,
# left untouched below so every node is equally eligible) and the REST discipline to it over
# the network — so the honest product claim is "hardware time-truth per node, disciplined
# across a mesh domain", never "free cross-node nanosecond alignment out of the box". A future
# phase adding an actual grandmaster (GNSS/PPS reference, or a fleet-designated boundary clock)
# would tighten this; nothing here assumes or fabricates one.
[Unit]
Description=PTP (IEEE-1588) boundary/ordinary clock — macb hardware timestamping, HookProbe PTP domain (ADR 0031 §B, base-tier-build-ticket.md Phase 3)
Documentation=man:ptp4l(8)
Documentation=file:///usr/share/hookprobe/docs/adr/0031-dataplane-performance-strategy.md
Documentation=file:///usr/share/hookprobe/docs/base-tier-build-ticket.md

# Same ordering discipline as hookprobe-tune-bcm2712.service (Phase 1): needs the signed
# manifest (for the ExecCondition ptp_hw gate below) and the reconciler's resolved WAN/LAN
# interface facts (ifaces.env — the macb behind RP1 IS this box's WAN uplink on the base tier,
# see the WAN_IFACE reuse note in [Service] below) before it can pick an interface to bind.
After=var-lib-hookprobe.mount hookprobe-bootstrap.service hookprobe-network-reconcile.service
Wants=hookprobe-bootstrap.service hookprobe-network-reconcile.service
ConditionPathExists=/var/lib/hookprobe/manifest.json

[Service]
Type=simple
# linuxptp binaries are not systemd-notify-aware upstream (no sd_notify calls) — Type=simple,
# no WatchdogSec=, matching the vendor's own ptp4l@.service template exactly (verified against
# the linuxptp 4.0 Debian/Ubuntu package's shipped unit). Do NOT copy the Type=notify pattern
# used by this repo's own binaries (hookprobe-psid etc.) — that would hang waiting for a
# READY=1 this binary never sends.

# --- capability gate: hardware-verified PTP only, never a fabricated grant --------------------
# `ptp_hw` is only ever `granted` where Phase-0's §5 metal gate confirmed the macb TSU behind
# RP1 actually exposes hardware rx/tx timestamping (`ethtool -T <macb-if>`) on THIS device —
# see crates/hookprobe-manifest/src/capabilities.rs. As of this phase that scan fact does not
# exist yet in HardwareScan (documented gap, same file), so `ptp_hw` is conservatively
# `present_unsafe` everywhere and this ExecCondition cleanly skips the unit (exit code from a
# failed ExecCondition is treated as "condition not met" — NOT a unit failure, no restart-loop)
# on every image until a real per-board scan fact lands. This is deliberate: shipping the unit
# now (dormant) lets Phase 5's metal gate exercise it the moment the scan fact + `granted` state
# land, with zero further unit-file changes.
ExecCondition=/bin/sh -c 'jq -e ".capabilities.ptp_hw.state == \"granted\"" /var/lib/hookprobe/manifest.json >/dev/null 2>&1'

# WAN_IFACE resolves to THIS device's manifest-classified WAN uplink (aegis::reconcile_network's
# `ifaces.env` artifact, same cross-platform fix as hookprobe-resource-shed.service/
# hookprobe-scan-responder.service). On the base tier (bcm2712, zero add-on hardware) the ONLY
# macb/GEM instance IS the RP1-fronted WAN uplink, so reusing WAN_IFACE here — rather than
# inventing a separate PTP_IFACE fact the reconciler doesn't emit — is an accurate equivalence,
# not a shortcut; a future platform that puts PTP on a DIFFERENT macb instance than the WAN
# uplink would need a real dedicated fact (flagged, not built here).
Environment=WAN_IFACE=end0
EnvironmentFile=-/var/lib/hookprobe/ifaces.env

# RuntimeDirectory=hookprobe-ptp (below) gives ptp4l a small dedicated /run subdir for its
# management UDS sockets — kept SEPARATE from /run/hookprobe (hookprobe-supervisor.service's
# own RuntimeDirectory=hookprobe, used for the manifest/control sockets) so this unit's sockets
# can never collide with or be mistaken for the supervisor's.
#
# -i: bind the macb WAN interface. -H: hardware time stamping (already linuxptp's own default
# when omitted; kept explicit so the choice is visible in `systemctl cat`, not implied).
# --domainNumber 44: a HookProbe-private PTP domain, deliberately NOT the IEEE default (0,
# which common AES67 audio/broadcast gear also uses) — keeps this mesh's local BMCA election
# from ever cross-talking with unrelated third-party PTP equipment that might share the LAN.
# --priority1/--priority2 left at the linuxptp default (128, i.e. NOT overridden) so every mesh
# node is equally eligible to self-elect master per the mesh-honesty note above — no node is
# hardcoded as "the" grandmaster, because none exists on this hardware.
# -m: log to stdout (journald captures it) -q: skip syslog (avoid double-logging under journald).
ExecStart=/usr/sbin/ptp4l -i ${WAN_IFACE} -H -m -q \
    --domainNumber 44 \
    --uds_address=/run/hookprobe-ptp/ptp4l.sock \
    --uds_ro_address=/run/hookprobe-ptp/ptp4l.ro.sock

Restart=on-failure
RestartSec=5

# Only privilege needed: CAP_NET_ADMIN (SIOCSHWTSTAMP hardware-timestamping ioctl on the macb
# interface), CAP_NET_BIND_SERVICE (PTP event/general ports 319/320 are <1024), CAP_SYS_TIME
# (clock_adjtime on the local PHC device, /dev/ptp0 — ptp4l disciplines the PHC itself; phc2sys,
# in the companion unit, is what then propagates that to CLOCK_REALTIME). No CAP_NET_RAW: this
# unit uses the default UDPv4 transport, not the `-2` IEEE-802.3 raw-frame transport.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SYS_TIME
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SYS_TIME
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Deliberately NOT ProtectClock=yes: that option (set on hookprobe-supervisor.service, where it
# belongs — the supervisor has no business touching any clock) SYSTEM-CALL-FILTERS OUT exactly
# the clock_adjtime/clock_settime family this daemon's entire job is to call. Same "don't harden
# away the one thing this unit must do" discipline as dataplane-tune-apply.sh's documented
# ProtectKernelTunables=yes omission.
RuntimeDirectory=hookprobe-ptp
RuntimeDirectoryMode=0750
ReadOnlyPaths=/var/lib/hookprobe/manifest.json
MemoryMax=24M
CPUQuota=5%
Nice=10
# Housekeeping slice per the ticket ("Ship ptp4l + phc2sys in the housekeeping slice") — low
# priority, deferrable-under-contention, same placement as hookprobe-psid.service (Phase 2).
Slice=hookprobe-background.slice

[Install]
WantedBy=multi-user.target
