[Unit]
Description=Shed-v2 PSI pressure watcher (eBPF resource-shed control-plane bridge, ADR 0031 §E)
Documentation=file:///usr/share/hookprobe/docs/adr/0031-dataplane-performance-strategy.md
Documentation=file:///usr/share/hookprobe/docs/base-tier-build-ticket.md
# Reads PSI stall-fraction pressure and writes the escalation tier + effective rate + a fresh
# heartbeat into the pinned `shed_ctrl` map napse_detect.bpf.c's per-packet fast loop reads —
# PSI cannot be read from inside eBPF directly, hence this scalar bridge (ADR 0031 §E). Needs
# the pinned map to exist first, which the napse-loader XDP attach path creates on load — but
# there is deliberately NO After=napse-loader.service here: that unit does not exist in this
# tree (modules/napse-capture's module.yaml documents the in-kernel XDP attach path as
# "tracked but NOT wired into the plan" yet — only napse-dpi, the userspace AF_PACKET sensor,
# is staged today). A phantom After= would silently resolve to zero ordering while looking
# load-bearing (builder/lint-units.sh's unit-lint gate catches exactly this class of bug), so
# it is omitted honestly instead. NOT a hard failure either way: this unit's own gate
# (resource_shed_v2 granted) plus Restart=on-failure already make it a fast, harmless
# no-op-retry until the map exists.
After=var-lib-hookprobe.mount hookprobe-bootstrap.service
Wants=hookprobe-bootstrap.service
ConditionPathExists=/var/lib/hookprobe/manifest.json

[Service]
Type=notify
NotifyAccess=main
# 20s watchdog interval x >=3 misses before systemd acts, per this codebase's own convention
# (see hookprobe_manifest::sd_notify::WatchdogPinger's doc) — this daemon ticks the watchdog
# once per poll() wake, and poll() itself never blocks longer than SHED_POLL_TIMEOUT_MS (1s
# default), so a genuinely alive process pings far more often than it needs to.
WatchdogSec=90s
Environment=SHED_CTRL_PIN=/sys/fs/bpf/hookprobe/shed_ctrl
Environment=CPU_PRESSURE_PATH=/proc/pressure/cpu
Environment=MEM_PRESSURE_PATH=/proc/pressure/memory
Environment=SHED_POLL_TIMEOUT_MS=1000
ExecStart=/usr/lib/hookprobe/hookprobe-psid
# napse-loader (re)attaching re-pins a FRESH shed_ctrl map on every restart (bpf.rs unpins +
# re-pins on load) — a stale open map handle here would silently write into a dead map, so
# restart this daemon too whenever its target could have moved.
Restart=on-failure
RestartSec=5

# Only privilege needed: CAP_BPF (bpf_obj_get + map update on the pinned shed_ctrl map) and
# CAP_DAC_OVERRIDE (writing a PSI trigger to /proc/pressure/{cpu,memory} — those files are
# root-writable-only; reading them needs no capability at all). No CAP_NET_ADMIN/CAP_NET_RAW —
# this daemon never touches a packet or a socket, only two /proc files and one BPF map.
AmbientCapabilities=CAP_BPF CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_BPF CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/sys/fs/bpf/hookprobe
ReadOnlyPaths=/var/lib/hookprobe/manifest.json
# /proc/pressure is deliberately NOT in ReadOnlyPaths above: ProtectSystem=strict never touches
# procfs's own pseudo-filesystem semantics (only the real filesystem hierarchy), and this daemon
# needs O_RDWR on /proc/pressure/{cpu,memory} to register psi-monitor TRIGGER fds (a plain read
# would only get the avg10/60/300 text, not the write-then-poll(POLLPRI) wake mechanism) —
# explicitly forcing it read-only here would silently break every trigger-fd registration and
# fall this daemon back to plain timeout polling on every device, which is not the intent.
PrivateTmp=yes
# Deliberately tiny: this daemon polls two small text files and writes 3 u64s to a map — the
# "housekeeping slice, hard CPUQuota" the ticket calls for (base-tier-build-ticket.md Phase 2) is
# this low CPU ceiling + the low-priority background slice below, never the live/detection path.
CPUQuota=3%
MemoryMax=16M
Slice=hookprobe-background.slice
Nice=10

[Install]
WantedBy=multi-user.target
