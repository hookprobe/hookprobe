# Connects a 5G/LTE modem (Get Online) from /etc/hookprobe/cellular.yaml via
# ModemManager. Only runs if the operator created a cellular config. The modem's
# driver/firmware must be in the image (docs/driver-strategy.md) — a USB 5G modem
# on a CM5 may need a driver sysext.

[Unit]
Description=HookProbe cellular (5G/LTE) connect via ModemManager
Documentation=https://github.com/hookprobe/hookprobe-os/blob/main/docs/driver-strategy.md
After=ModemManager.service network-pre.target
Wants=ModemManager.service
ConditionPathExists=/etc/hookprobe/cellular.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/hookprobe/cellular-connect.sh /etc/hookprobe/cellular.yaml

[Install]
WantedBy=multi-user.target
