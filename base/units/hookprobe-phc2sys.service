# hookprobe-phc2sys.service — base-tier-build-ticket.md Phase 3 (PTP time-truth, userspace),
# companion to hookprobe-ptp4l.service. `ptp4l` disciplines the macb PHC against the elected
# BMCA master (itself, if this node wins the election — see hookprobe-ptp4l.service's mesh-
# honesty note); `phc2sys` is the piece that then propagates that disciplined time onto
# CLOCK_REALTIME (and, symmetrically, feeds CLOCK_REALTIME back into the PHC when this node
# IS the elected master and there is nothing else disciplining it) so every consumer that reads
# the ordinary system clock — including NAPSE's own event timestamps where hardware
# timestamping isn't in the capture path — benefits from the same PHC-disciplined time base.
#
# MESH HONESTY: see hookprobe-ptp4l.service's [Unit] header — this unit inherits the exact same
# caveat (locally-precise hardware time-truth; cross-node absolute alignment needs a PTP domain
# WITH a master, which this box supplies only via BMCA self-election, never a GNSS grandmaster).
[Unit]
Description=Synchronize CLOCK_REALTIME with the ptp4l-disciplined macb PHC (ADR 0031 §B, base-tier-build-ticket.md Phase 3)
Documentation=man:phc2sys(8)
Documentation=file:///usr/share/hookprobe/docs/adr/0031-dataplane-performance-strategy.md
Documentation=file:///usr/share/hookprobe/docs/base-tier-build-ticket.md

# Hard dependency (Requires=, not just Wants=): phc2sys's `-a` automatic mode reads its
# synchronization directions live from ptp4l's management UDS socket — with no ptp4l running
# there is nothing for it to do but spin retrying, so it is ordered strictly after it, matching
# the vendor's own phc2sys@.service template (`Requires=ptp4l.service` / `After=ptp4l.service`).
Requires=hookprobe-ptp4l.service
After=hookprobe-ptp4l.service
ConditionPathExists=/var/lib/hookprobe/manifest.json

[Service]
Type=simple
# Same reasoning as hookprobe-ptp4l.service: linuxptp binaries never call sd_notify — Type=simple,
# no WatchdogSec=.

# Same capability gate as hookprobe-ptp4l.service (`ptp_hw` is `present_unsafe` everywhere until
# a real per-board macb-hw-timestamping scan fact lands — crates/hookprobe-manifest/src/
# capabilities.rs) — repeated here rather than relied on transitively so this unit degrades the
# same clean, non-failing way even if it is ever started without going through the Requires=
# chain above (e.g. a manual `systemctl start`).
ExecCondition=/bin/sh -c 'jq -e ".capabilities.ptp_hw.state == \"granted\"" /var/lib/hookprobe/manifest.json >/dev/null 2>&1'

# -a: automatic mode — follow ptp4l's live port-state, syncing whichever direction BMCA decided
#     (this node disciplines its system clock FROM the PHC when it lost the election and is a
#     slave; it feeds the PHC FROM the system clock when it won and has nothing else to sync
#     the PHC from — phc2sys picks the direction, we do not hardcode one).
# -rr: (the doubled -r, per phc2sys(8)) makes CLOCK_REALTIME eligible to be a SOURCE as well as
#      a sink — needed for the master-role case above; a single -r only ever makes it a sink.
# -z: point at the SAME non-default UDS path hookprobe-ptp4l.service's ptp4l instance was told
#     to listen on (--uds_address= in that unit) — must stay in lockstep with it.
# -m/-q: journald logging, same convention as ptp4l's unit.
ExecStart=/usr/sbin/phc2sys -a -rr -z /run/hookprobe-ptp/ptp4l.sock -m -q

Restart=on-failure
RestartSec=5

# Only privilege needed: CAP_SYS_TIME (clock_adjtime/clock_settime on CLOCK_REALTIME and the
# PHC device). No CAP_NET_ADMIN/CAP_NET_RAW/CAP_NET_BIND_SERVICE — unlike ptp4l, phc2sys never
# opens a network socket itself; it only talks to ptp4l over the local UDS (already covered by
# read access to the ptp4l unit's own RuntimeDirectory=hookprobe-ptp, owned root:root 0750 —
# this unit also runs as root/UID 0, so the owner-match permission bits already grant it access
# with no extra capability needed).
AmbientCapabilities=CAP_SYS_TIME
CapabilityBoundingSet=CAP_SYS_TIME
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Deliberately NOT ProtectClock=yes — see hookprobe-ptp4l.service's identical note; this unit's
# entire job is exactly the syscalls that option would filter out.
ReadOnlyPaths=/var/lib/hookprobe/manifest.json
MemoryMax=16M
CPUQuota=3%
Nice=10
# Housekeeping slice per the ticket, same placement as its ptp4l companion above.
Slice=hookprobe-background.slice

[Install]
WantedBy=multi-user.target
