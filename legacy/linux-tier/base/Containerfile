# =============================================================================
# HookProbe OS — Base bootc image (Readme Pillar 1: "the OS is a Containerfile")
# =============================================================================
#
# This single Containerfile IS the operating system for every platform. Build it
# with `podman build`, cosign-sign it, push it to a registry — that half is
# genuinely universal (ADR 0019 D1). The UPDATE MECHANISM is split by boot model
# (ADR 0019 D2/D3, refining CLAUDE.md decision #1's literal "devices `bootc
# upgrade`/`rollback`" claim): on UEFI tiers (N100/VM/cloud/RK3588 w/ UEFI) devices
# run real `bootc upgrade`/`bootc rollback`; on the rpi-native tier (today's
# shipping Pi4 image) there is no bootc and no second slot — updates there are an
# OCI-derived A/B image-sync path (ADR 0019 D3, Phase 3, not yet shipped), and a
# failed boot today is a reflash, not a rollback (see base/greenboot/README.md).
# One OCI image remains the universal source of truth on every platform; hardware
# differences are absorbed by the Platform Manifest at first boot (Architecture §2).
#
# HONESTY: this is a reviewed, buildable-in-CI scaffold. `podman` IS available on
# this dev box (fortress001, verified 2026-07-05) but its `podman build` RUN steps
# cannot reach github.com or deb.debian.org (confirmed empirically — see the
# `bootc-tools` stage comment below); registry pulls (`podman pull`) DO work. So
# this Containerfile is buildable up to whatever needs that egress, and CI (with
# real network access) is required to complete/verify it end-to-end. Genuinely-
# unknown specifics are marked `# TODO:` rather than invented. See base/README.md
# for the FROM rationale, the CI build/sign flow, and the TBD list.
#
# Build context = REPO ROOT (so the builder stage can see the Rust workspace):
#   podman build -f base/Containerfile \
#     --build-arg PROFILE=edge-pro --build-arg TARGETARCH=arm64 -t hookprobe-os:dev .
#
# Layers, top to bottom:
#   [stage build]  cross-compile the host-integral Rust binaries (bootstrap, supervisor)
#   [stage os]     bootc base → apt host packages → wasmtime → cosign → eBPF/XDP bits
#                  → COPY binaries + signed RO id→capability tables → systemd units
#                  → kargs / sysctls / cgroup slices → cosign signed-by policy
#                  → /var data-partition split → bootc container lint
# =============================================================================


# -----------------------------------------------------------------------------
# Global build args (pinned in CI; see base/profiles/*.yaml and base/README.md)
# -----------------------------------------------------------------------------
# PROFILE selects the build variant (base/profiles/<PROFILE>.yaml). It only tunes
# which optional packages/slices ship; the SAME image still self-detects hardware.
ARG PROFILE=edge-pro
# TARGETARCH is the OCI build platform arch token: arm64 | amd64 | riscv64.
# CI builds a matrix; bootc-image-builder later targets the disk format per profile.
ARG TARGETARCH=arm64

# Pinned toolchain/runtime versions (F9 fix — verify the verifier). These two exact
# releases are validated-as-of-2026; CI bumps them deliberately, never floats a "latest".
#
# WASMTIME_VERSION MUST equal the EMBEDDED Wasmtime crate `supervisor/Cargo.toml`/`Cargo.lock`
# pins (today: 27.0.0) — ADR 0017 D3/Blocker. The embedded library is what actually produces
# (`precompile_module`) and consumes (`Module::deserialize`) every `.cwasm`; this standalone CLI
# never touches AOT blobs at all, but the two are kept in lockstep DELIBERATELY so nobody bumps
# one without the other and silently degrades every device's AOT load to the slow JIT floor. The
# `build` stage below asserts this at build time and fails closed on any drift. Previously pinned
# at 29.0.1 (mismatched with the embedded 27.0.0) — reconciled down to 27.0.0 by ADR 0017; bump
# BOTH together (this ARG + supervisor/Cargo.toml's `wasmtime`/`wasmtime-wasi` deps + Cargo.lock)
# if the embedded crate is ever upgraded.
ARG WASMTIME_VERSION=27.0.0
ARG COSIGN_VERSION=2.4.1             # sigstore/cosign release; verified via its own published
                                     # cosign_checksums.txt at build time (Layer C below) — no
                                     # hash needs pinning here, the manifest IS the pin.
ARG RUST_BUILDER_IMAGE=docker.io/library/rust:1-slim-trixie   # TODO: pin by digest (tag order is slim-<suite>)

# wasmtime publishes NO checksums manifest for its release tarballs (unlike cosign) — verified
# by inspecting every asset name on the v29.0.1 release (this repo's asset-naming convention
# check predates the ADR 0017 reconciliation down to 27.0.0; bytecodealliance/wasmtime uses the
# identical `wasmtime-v<ver>-<arch>-linux.tar.xz` naming across releases, but re-verify the exact
# v27.0.0 asset names before computing a fresh hash below rather than assuming it unverified);
# only the raw .tar.xz/.zip/.wasm files ship, no SHA256SUMS/.sha256 sidecar, no per-asset GitHub
# "digest" (that field is only populated for repos with immutable-releases enabled, which this
# one is not). So the honest supply-chain fix (F9) is a PINNED expected sha256 per arch, computed
# ONCE from the exact tarball CI actually fetches and supplied as a build-arg (the same practice
# Nixpkgs/Homebrew/Arch PKGBUILDs use for third-party tarballs with no upstream checksum file) —
# NOT a value invented here. Compute with (substitute WASMTIME_VERSION's current value, 27.0.0):
#   curl -fsSL -o w.tar.xz https://github.com/bytecodealliance/wasmtime/releases/download/v27.0.0/wasmtime-v27.0.0-<arch>-linux.tar.xz && sha256sum w.tar.xz
# Left EMPTY by default: the build FAILS closed (Layer B below) rather than silently skipping
# verification, unless SKIP_GITHUB_DL=1 (the existing offline/dev escape hatch) is also set.
ARG WASMTIME_SHA256_AARCH64=
ARG WASMTIME_SHA256_X86_64=
ARG WASMTIME_SHA256_RISCV64GC=

# Upstream bootc base — RESOLVED (ADR 0019 D2, Phase 1). The previously pinned
# `ghcr.io/bootcrew/debian-bootc:trixie` was NOT pullable from any registry (found at
# build Gate 0, 2026-06-30) and no official Debian/Ubuntu bootc base image exists
# anywhere (only RPM-based bases do: quay.io/fedora/fedora-bootc,
# quay.io/centos-bootc/centos-bootc). ADR 0019 resolved this: build OUR OWN
# Debian-bootc base, `FROM` plain `debian:trixie` + apt (kernel-6.x, systemd-boot,
# dracut, ostree, ukify, grub-efi, skopeo — Layer B2 below) + compiled `bootc` +
# `bootupd` (composefs-rs rides in as bootc's own Cargo dependency, not a separate
# build — F1). Verified pullable (`podman pull docker.io/library/debian:trixie`,
# 2026-07-05). Track `bootcrew/mono` upstream as a reference, but do not depend on
# it existing as a registry image.
ARG BASE_IMAGE=docker.io/library/debian:trixie

# bootc-substrate versions (ADR 0019 D2 Layer B2). PINNED, never floated — the
# composefs-native backend is experimental (F1: "not yet suitable for production
# use" as of bootc v1.10.1, where it became always-compiled-in). Verified via the
# GitHub releases API on 2026-07-05 (this box CAN reach registries/APIs but is
# egress-blocked for raw github.com/deb.debian.org fetches from inside a build
# RUN step — see base/README.md "What CI needs" / Layer B2 below): bootc v1.16.3
# (2026-07-02) pairs with bootupd v0.2.35 (2026-06-12, itself bumped to
# bootc-internals v1.16.0) — a matched, not arbitrary, pair. Re-verify + bump
# deliberately (ADR 0019 Phase 4 — composefs stabilization tracking).
ARG BOOTC_VERSION=1.16.3
ARG BOOTUPD_VERSION=0.2.35


# =============================================================================
# Stage 1 — builder: cross-compile the host-integral Rust binaries + every crate
# `builder/generated/staging-plan.json` (ADR 0015 — registry-driven module inclusion)
# says this arch needs, THEN assemble a copy-ready tree via the SAME stage-apply.sh
# build-arm64.sh/build-vm.sh use. This is what closes the "hollow bootc SOC" bug (ADR
# 0015 context): previously this stage hand-built only 2 host binaries + 4 wasm
# modules, so the base preset's `enable`s for senzorium-flow/napse-dpi/host-telemetry/
# napse-quarantine/hookprobe-evidence.timer referenced units this stage never
# installed. Now bootc reaches arm64 parity structurally, not via a second hand-list.
#
# PREREQUISITE (host-side, before `podman build`): generate the plan for THIS arch —
#   builder/gen-staging.sh --arch ${TARGETARCH} \
#     --out builder/generated/staging-plan.json \
#     --preset-out builder/generated/85-hookprobe-modules.preset
# (mirrors gen-matrix.sh's existing "run before CI needs it" pattern). The build
# FAILS at the `COPY builder/generated/staging-plan.json` step below if this wasn't done.
# -----------------------------------------------------------------------------
# TODO (supply chain): CI may instead inject PRE-BUILT, independently cosign-signed
# binaries + their SBOM here, keeping the base build hermetic and the binaries
# attestable on their own. This in-image build stage is the simplest correct path.
# TODO (bpf toolchain): the `--features bpf` crates in `build_targets` (napse-loader's
# XDP path if ever added, napse-quarantine, hookprobe-execsnoop) need libbpf-rs's
# system deps (libelf/zlib headers) at compile time — added below. Genuinely unverified
# on the dev box (no podman); flag if the base image's libelf/zlib versions drift.
# =============================================================================
FROM ${RUST_BUILDER_IMAGE} AS build
WORKDIR /src
ARG WASMTIME_VERSION

# Copy only what the workspace needs to *resolve* (all member manifests) and
# *build* the host binaries + every module the plan stages + their shared crates.
COPY Cargo.toml Cargo.lock ./
COPY crates/   crates/
COPY bootstrap/ bootstrap/
COPY supervisor/ supervisor/
COPY modules/   modules/

# ADR 0017 Blocker fix — Wasmtime version-drift CI assertion. The EMBEDDED Wasmtime crate
# (`supervisor/Cargo.toml: wasmtime = "27"`, pinned exactly by Cargo.lock) is what actually
# PRODUCES (`precompile_module`, Layer D2 below) and CONSUMES (`Module::deserialize`,
# `wasm_loader::load_module_gated`) every `.cwasm`; the standalone Wasmtime CLI installed in
# stage `os` (Layer B, `WASMTIME_VERSION`) is a SEPARATE binary that never touches AOT blobs at
# all. They must nonetheless be kept in lockstep on purpose (ADR 0017 D3's "Blocker" — letting
# them drift invites someone to "fix" the mismatch by bumping one side only, which would make
# every device `Module::deserialize` silently fail and fall back to the slow-but-safe JIT floor
# with NO loud error, only the `aot_fallback_total` telemetry counter to notice). Fail the build
# CLOSED, loudly, right here, rather than let that drift ship silently.
RUN set -eux; \
    locked="$(awk '/^name = "wasmtime"$/{f=1;next} f && /^version = /{gsub(/"/,"",$3); print $3; exit}' Cargo.lock)"; \
    if [ -z "$locked" ]; then echo "ERROR: could not find a Cargo.lock entry for the 'wasmtime' crate — cannot assert version parity (ADR 0017)" >&2; exit 1; fi; \
    if [ "$locked" != "${WASMTIME_VERSION}" ]; then \
      echo "ERROR: Wasmtime version drift (ADR 0017 Blocker): embedded crate (Cargo.lock) = ${locked}, but --build-arg WASMTIME_VERSION = ${WASMTIME_VERSION}." >&2; \
      echo "  These MUST match: the embedded crate is what produces+consumes every .cwasm; a drift silently degrades every AOT load to the JIT floor." >&2; \
      echo "  Fix: pass --build-arg WASMTIME_VERSION=${locked} (or bump supervisor/Cargo.toml's wasmtime dep + re-lock, then update this arg to match)." >&2; \
      exit 1; \
    fi; \
    echo "OK: build-stage embedded Wasmtime (Cargo.lock) == WASMTIME_VERSION (${locked}) — ADR 0017 version-drift assertion passed"
# host-telemetry's staging: block sources base/config/journald.conf.d/hookprobe.conf —
# the ONLY non-crates/non-modules repo path any staging action currently references.
COPY base/config/journald.conf.d/ base/config/journald.conf.d/
# The generator's output (host-side prerequisite — see header) + the dumb applier.
COPY builder/generated/staging-plan.json                 /plan.json
COPY builder/generated/85-hookprobe-modules.preset       /85-hookprobe-modules.preset
COPY builder/stage-apply.sh                              /usr/local/bin/stage-apply.sh
RUN chmod 0755 /usr/local/bin/stage-apply.sh

# jq (stage-apply.sh's only non-bash/coreutils dependency) + the bpf-feature crates'
# system deps. libbpf-sys' build.rs (VERIFIED empirically building this stage, ADR 0015)
# needs: `make` always (libbpf-sys's own Makefile-driven bpf_helper_defs.h generation,
# regardless of vendoring); `autoreconf`+`libtool` ADDITIONALLY when a crate vendors
# libelf/zlib from source (napse-quarantine's Cargo.toml `features=["vendored"]" — the
# vendored-libelf/vendored-zlib paths autotools-build those from scratch). libelf-dev/
# zlib1g-dev/pkg-config cover the NON-vendored path (host-telemetry's loader today).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      jq libelf-dev zlib1g-dev pkg-config clang make autoconf automake libtool gettext autopoint \
      flex bison gawk m4 gcc \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Build the host binaries. `hookprobe-supervisor` is built WITH `--features wasm`
# (Wasmtime embedded as a library — ADR 0009 build step 1; NOT built without it, or
# `--run-wasm`/`--precompile` don't exist and reconcile falls back to a no-op load).
# Two separate invocations: `--features wasm` only applies to hookprobe-supervisor
# (hookprobe-bootstrap has no such feature) and this keeps that unambiguous.
RUN cargo build --release -p hookprobe-bootstrap \
 && cargo build --release -p hookprobe-supervisor --features wasm \
 && mkdir -p /out \
 && cp target/release/hookprobe-bootstrap  /out/ \
 && cp target/release/hookprobe-supervisor /out/

# Build every crate `plan.build_targets` names (ADR 0015 D2 build step 2) — the
# deduplicated set every staged, non-stub module needs for THIS arch: the four wasm
# engines (napse/qsecbit/dnsxai/aegis-guard) PLUS, new as of this ADR, napse-loader
# (→ napse-dpi), napse-quarantine, hookprobe-evidence, hookprobe-execsnoop. `wasm`
# toolchain crates build for wasm32-wasip1 (Readme Pillar 2: one `.wasm` runs on
# arm64/amd64/riscv64 unmodified). Every other toolchain (`musl`/`gnu` in the plan)
# builds NATIVE here: unlike build-arm64.sh (cross-compiling FROM an x86_64 dev box),
# this stage already runs AS the target platform (`--platform linux/${TARGETARCH}`,
# QEMU-emulated in CI) — so there is no cross/native distinction to make inside the
# container; both the plan's `{bin}` and `{gnu_bin}` placeholders resolve to the SAME
# `target/release/` below.
RUN rustup target add wasm32-wasip1 \
 && jq -r '.build_targets[] | [.crate, .toolchain, ((.features // []) | join(","))] | @tsv' /plan.json > /tmp/build_targets.tsv \
 && while IFS="$(printf '\t')" read -r crate toolchain features; do \
      echo "build_target: crate=$crate toolchain=$toolchain features=$features"; \
      if [ "$toolchain" = "wasm" ]; then \
        if [ -n "$features" ]; then cargo build --release --target wasm32-wasip1 -p "$crate" --features "$features"; \
        else cargo build --release --target wasm32-wasip1 -p "$crate"; fi; \
      else \
        if [ -n "$features" ]; then cargo build --release -p "$crate" --features "$features"; \
        else cargo build --release -p "$crate"; fi; \
      fi; \
    done < /tmp/build_targets.tsv

# ADR 0017 D3 — precompile every `runtime: wasm` module's `.cwasm`, NATIVE to this arch, right
# here in the SAME stage that just built its `.wasm` (no separate cross-AOT step: this stage
# already runs AS ${TARGETARCH}, QEMU-emulated — the objection that killed build-time precompile
# in ADR 0009 no longer applies). Uses the ALREADY-BUILT `/out/hookprobe-supervisor` (with
# `--features wasm`) and its existing `--precompile all` mechanism (reused, not re-invented) —
# writes `<id>.cwasm` next to the `.wasm` it was just compiled from
# (`target/wasm32-wasip1/release/`), which is exactly where `gen-staging.sh`'s `{wasm}/{mid}.cwasm`
# install action (marked `optional`) expects to find it. A module with no local `.wasm` (a stub,
# or one this arch's plan didn't build) is skipped by `--precompile all` itself, not an error here.
RUN /out/hookprobe-supervisor --precompile all --modules /src/modules \
 && echo "ADR 0017: precompiled every runtime:wasm module's .cwasm natively for arch=${TARGETARCH}"

# Assemble the copy-ready tree (ADR 0015 D2 build step 3): every staged module's
# artifacts + units + module.yaml/module.sig registry mirror, placed exactly where
# stage `os` expects them. `--relaxed`: a crate this specific arch/profile combination
# doesn't have build inputs for yet (rare — build_targets is derived from the SAME
# plan) degrades to a warning rather than failing the whole image; CI should drop
# `--relaxed` once every build_targets crate is proven to compile in this stage (see
# the bpf-toolchain TODO above).
RUN REPO=/src WASM=/src/target/wasm32-wasip1/release BIN=/src/target/release GNU_BIN=/src/target/release \
    stage-apply.sh /plan.json /out/tree --relaxed \
 && mkdir -p /out && cp /85-hookprobe-modules.preset /out/85-hookprobe-modules.preset


# =============================================================================
# Stage 1b — bootc-tools: compile `bootc` + `bootupd` (ADR 0019 D2, Phase 1).
# =============================================================================
# Debian trixie's own apt already ships kernel-6.x/systemd-boot/dracut/ostree/
# ukify/grub-efi/skopeo (F1) — the base does NOT need a from-scratch bootc distro.
# The genuinely missing pieces are two compiled Rust binaries: `bootc` itself (its
# composefs-native backend pulls in `composefs-rs` as an ordinary Cargo
# dependency — NOT a third separate build, correcting an earlier reading of ADR
# 0019 F1's "bootc + composefs(-rs) + bootupd" as three build targets) and
# `bootupd` (a separate upstream project bootc's composefs backend shells out to
# for bootloader installs). Built in their OWN stage, like `build` above, so the
# final `os` image never carries a Rust toolchain.
#
# HONEST ENVIRONMENT NOTE (verified 2026-07-05, this repo's dev/build box): a
# plain `podman build` RUN step here CANNOT reach github.com OR deb.debian.org —
# confirmed empirically (`apt-get update` inside a `podman build` RUN times out /
# "Connection failed"; `podman pull docker.io/...` from the HOST netns works
# fine). This is a strictly BROADER version of the existing `SKIP_GITHUB_DL`
# escape hatch's rationale (previously scoped to "github release egress"); it
# now also covers Debian's own apt mirrors from inside a build's network
# namespace on this box. Reusing `SKIP_GITHUB_DL` (rather than inventing a
# second flag) for BOTH the git clone below and this stage's own apt-get: a real
# CI runner with unrestricted egress builds this stage for real; this box cannot
# and does not pretend otherwise.
# =============================================================================
FROM ${RUST_BUILDER_IMAGE} AS bootc-tools
ARG BOOTC_VERSION
ARG BOOTUPD_VERSION
ARG SKIP_GITHUB_DL
WORKDIR /src

# Build-time system deps bootc/bootupd need beyond rustc/cargo (verified against
# upstream CONTRIBUTING notes as of 2026-07-05: cargo, git, dracut, glibc, ostree
# dev headers — NOT a from-scratch guess). TODO(CI): re-verify this exact list
# the first time this stage actually completes a build; a missing -dev header
# here fails LOUDLY (apt-get -y with no --no-install-recommends surprises), not
# silently — this repo's existing convention (see Layer A comment in stage `os`).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    if [ -n "${SKIP_GITHUB_DL}" ]; then \
      echo "SKIP_GITHUB_DL set -> skipping bootc-tools build-dep apt-get (no build-time egress assumed)"; \
    else \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        git pkg-config libssl-dev libostree-dev zlib1g-dev libzstd-dev clang \
      && apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

# Fetch + build `bootc` (pinned tag, D2). Source-only GitHub release (no
# prebuilt binaries for bootc-dev/bootc as of v1.16.3 — verified via the
# releases API, 2026-07-05: assets are `bootc-<ver>.tar.zstd` +
# `bootc-<ver>-vendor.tar.zstd` source archives only) — `git clone --branch`
# pinned to the release tag is the reproducible, dependency-free route (no
# separate checksum manifest exists to verify a tarball against, same gap the
# wasmtime layer below already documents for exactly this reason).
RUN set -eux; \
    if [ -n "${SKIP_GITHUB_DL}" ]; then \
      echo "SKIP_GITHUB_DL set -> writing an HONEST stub for /out/bootc (github.com egress unavailable in THIS build environment — see ADR 0019 Phase 1 / base/README.md 'What CI needs'). A real CI runner with egress must build this stage for a real bootc binary to ship."; \
      mkdir -p /out; \
      printf '#!/bin/sh\necho "bootc: NOT COMPILED -- this image was built with SKIP_GITHUB_DL=1 (no build-time egress). See ADR 0019 Phase 1 / base/README.md." >&2\nexit 1\n' > /out/bootc; \
      chmod 0755 /out/bootc; \
    else \
      git clone --depth 1 --branch "v${BOOTC_VERSION}" https://github.com/bootc-dev/bootc /src/bootc; \
      cd /src/bootc && cargo build --release --locked --bin bootc; \
      mkdir -p /out && cp target/release/bootc /out/bootc; \
      /out/bootc --version; \
    fi

# Fetch + build `bootupd` (pinned tag, D2) — the bootloader-install helper
# bootc's composefs backend shells out to; a separate upstream project, same
# source-only-release caveat as bootc above.
RUN set -eux; \
    if [ -n "${SKIP_GITHUB_DL}" ]; then \
      echo "SKIP_GITHUB_DL set -> writing an HONEST stub for /out/bootupd (same reason as bootc above)."; \
      mkdir -p /out; \
      printf '#!/bin/sh\necho "bootupd: NOT COMPILED -- this image was built with SKIP_GITHUB_DL=1 (no build-time egress). See ADR 0019 Phase 1 / base/README.md." >&2\nexit 1\n' > /out/bootupd; \
      chmod 0755 /out/bootupd; \
    else \
      git clone --depth 1 --branch "v${BOOTUPD_VERSION}" https://github.com/coreos/bootupd /src/bootupd; \
      cd /src/bootupd && cargo build --release --locked --bin bootupd; \
      mkdir -p /out && cp target/release/bootupd /out/bootupd; \
      /out/bootupd --version || true; \
    fi


# =============================================================================
# Stage 2 — os: the bootc image proper.
# =============================================================================
FROM ${BASE_IMAGE} AS os

ARG PROFILE
ARG TARGETARCH
ARG WASMTIME_VERSION
ARG COSIGN_VERSION
ARG BOOTC_VERSION
ARG BOOTUPD_VERSION
ARG WASMTIME_SHA256_AARCH64
ARG WASMTIME_SHA256_X86_64
ARG WASMTIME_SHA256_RISCV64GC
# Offline / air-gapped build support (and a CI escape hatch when GitHub release egress is
# unavailable): set SKIP_GITHUB_DL=1 to skip fetching wasmtime + cosign from GitHub. The
# resulting image lacks the Wasm runtime + the cosign verifier (so it can't RUN Wasm
# modules or verify signatures on device) but is otherwise complete — fine for proving the
# bootstrap→manifest→reconcile→trust flow. TODO: support vendored tarballs in the context.
# ADR 0019 D2: the SAME flag also governs the `bootc-tools` stage above (bootc/bootupd
# compiled-from-source) — one flag for "this environment has no build-time egress",
# not a family of one-off escape hatches.
ARG SKIP_GITHUB_DL=

# OCI/bootc labels. `containers.bootc=1` marks this as a bootable container so
# tooling (bootc, bootc-image-builder) treats it correctly.
LABEL org.opencontainers.image.title="HookProbe OS — Base"
LABEL org.opencontainers.image.description="AI-native security OS, delivered as a signed bootc image. One OS, every platform; hardware unlocks capabilities."
LABEL org.opencontainers.image.vendor="HookProbe"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.source="https://github.com/hookprobe/hookprobe-os"
LABEL containers.bootc="1"
LABEL hookprobe.os.profile="${PROFILE}"

# -----------------------------------------------------------------------------
# Layer A — host packages (apt). "You own every layer": missing OVS? install it.
# Grouped so the image stays legible. `apt-get clean` + lists removal keeps the
# committed layer small (bootc pulls registry deltas, so layer hygiene matters).
# -----------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      # --- container runtime: rootless Podman + Quadlet for `runtime: container` modules ---
      podman \
      crun \
      catatonit \
      fuse-overlayfs \
      slirp4netns \
      passt \
      uidmap \
      # --- SDN dataplane: image-layer OVS for the `openvswitch`/`sdn` capability ---
      #     (host-integral; NOT a Wasm module — see docs/architecture/runtime-engine-map.md)
      openvswitch-switch \
      openvswitch-common \
      # --- L3 firewall/enforcement (Gap 1 fix, packaging audit 2026-07-07): the
      #     reconciler (crates/hookprobe-manifest/src/nac.rs et al.) UNCONDITIONALLY
      #     emits `nft add table/rule ...` for NAC/microseg/WAN-allowlist/quarantine
      #     whenever `capture`/`openvswitch`/`nac` are granted — this was previously
      #     absent from every bootc image, so those `nft` calls exited 127 SILENTLY
      #     (the reconciler logs but does not hard-fail on it). mkosi-arm64/mkosi.conf
      #     already carries this for the Pi tier; this brings the bootc UEFI tier to
      #     parity so it isn't ONLY the mkosi/Pi image that enforces L3.
      nftables \
      # --- eBPF/XDP runtime for the NAPSE-capture sysext (libbpf/CO-RE loader) ---
      #     CO-RE objects are PRE-COMPILED into the sysext; we ship loader libs +
      #     tools at runtime, NOT clang/llvm (no on-device compilation on an
      #     immutable image — runtime-engine-map §0, open-Q 2).
      libbpf1 \
      libxdp1 \
      xdp-tools \
      bpftool \
      ethtool \
      iproute2 \
      kmod \
      # --- PTP (IEEE-1588) time-truth userspace (base-tier-build-ticket.md Phase 3;
      #     ADR 0031 §B): `linuxptp` provides /usr/sbin/ptp4l + /usr/sbin/phc2sys,
      #     the daemons base/units/hookprobe-ptp4l.service + hookprobe-phc2sys.service
      #     ExecStart. Disciplines the Phase-0 macb PHC (/sys/class/ptp/ptp0) — both
      #     units ExecCondition-gate on the `ptp_hw` capability, so this package is
      #     safe to ship everywhere (dormant, no-op) even before that capability scan
      #     fact lands (crates/hookprobe-manifest/src/capabilities.rs).
      linuxptp \
      # --- hardware probe deps used ONCE by bootstrap (detect once, query forever) ---
      lshw \
      pciutils \
      usbutils \
      dmidecode \
      iw \
      tpm2-tools \
      mokutil \
      util-linux \
      # --- TLS / crypto runtime (PQC-agile transport per ADR 0002 is in the Rust
      #     binaries via rustls; these are the system trust + openssl baseline) ---
      ca-certificates \
      openssl \
      # --- Data-at-rest LUKS + TPM auto-unlock (Gap 2 fix, packaging audit
      #     2026-07-07; ADR 0007). `firstboot-data`/`firstboot-provision-data.sh`
      #     call `cryptsetup` to open the encrypted `hookprobe-data` volume — the
      #     amd64 mkosi.conf's own comment already flags "without it firstboot-data
      #     exits 127"; that was equally true here and equally unfixed. `clevis`+
      #     `clevis-tpm2`+`clevis-luks` give the TPM-bound auto-unlock path (E3);
      #     `cryptsetup-initramfs`/`clevis-initramfs` wire early-boot unlock into
      #     dracut's initrd (this stage's initramfs generator — Layer A2 below —
      #     vs mkosi's initramfs-tools, hence BOTH `-initramfs` packages are still
      #     correct here). Matches builder/mkosi/mkosi.conf +
      #     builder/mkosi-arm64/mkosi.conf's cryptsetup/clevis/tpm2-tools/openssl
      #     set exactly (tpm2-tools already shipped above) — bootc and mkosi must
      #     not diverge on the data-at-rest story.
      cryptsetup \
      cryptsetup-initramfs \
      clevis \
      clevis-luks \
      clevis-tpm2 \
      clevis-initramfs \
      # --- minimal operational tooling ---
      jq \
      curl \
      xz-utils \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Layer A2 — bootc substrate host packages (ADR 0019 D2, Phase 1). Debian trixie's
# apt already ships everything the bootc/composefs-native model needs on the UEFI
# tier EXCEPT the two compiled binaries (Layer B2 below): kernel-6.x, systemd-boot
# (bootctl/sd-boot), the ukify UKI builder, ostree (composefs-native's fallback/
# interop tooling), dracut, grub-efi (BIOS/legacy-compat + non-systemd-boot
# fallback), skopeo (registry inspection bootc uses under the hood). Arch-qualified
# package names (kernel meta-package, grub-efi-<arch>-bin) — riscv64 has no
# systemd-boot/grub-efi story upstream yet, so it's intentionally left OUT of the
# bootc-substrate packages (bootc/UEFI is a UEFI-tier concern per ADR 0019 F2; a
# riscv64 image simply won't carry these — no bootc there either, same honesty
# rule as the Pi tier).
# -----------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    set -eux; \
    case "${TARGETARCH}" in \
      amd64)   KERNEL_PKG=linux-image-amd64;  GRUB_PKG=grub-efi-amd64-bin ;; \
      arm64)   KERNEL_PKG=linux-image-arm64;  GRUB_PKG=grub-efi-arm64-bin ;; \
      riscv64) KERNEL_PKG=; GRUB_PKG= ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH} for bootc-substrate packages" >&2; exit 1 ;; \
    esac; \
    if [ -z "$KERNEL_PKG" ]; then \
      echo "TARGETARCH=${TARGETARCH}: no bootc/UEFI substrate packages for this arch (ADR 0019 F2 — bootc is UEFI-tier only); skipping Layer A2."; \
    else \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        "$KERNEL_PKG" \
        systemd-boot \
        systemd-ukify \
        ostree \
        dracut \
        "$GRUB_PKG" \
        skopeo \
      && apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

# -----------------------------------------------------------------------------
# Layer A3 — enable the `non-free-firmware` apt component (Gap 3 prerequisite,
# packaging audit 2026-07-07). The stock `docker.io/library/debian:trixie` base
# ships `/etc/apt/sources.list.d/debian.sources` (deb822) with `Components: main`
# ONLY (verified empirically against the real pulled image, 2026-07-07) — none of
# `firmware-misc-nonfree`/`firmware-realtek`/`firmware-atheros`/`firmware-iwlwifi`/
# `firmware-brcm80211` (all in `non-free-firmware`, per packages.debian.org) are
# resolvable without this. Mirrors builder/mkosi-arm64/mkosi.conf's
# `Repositories=main,contrib,non-free-firmware`. Handles both the deb822 file (the
# base image's actual format) and, defensively, a legacy one-line sources.list (in
# case the base image's format ever changes) — idempotent either way.
# -----------------------------------------------------------------------------
RUN set -eux; \
    SRC=/etc/apt/sources.list.d/debian.sources; \
    if [ -f "$SRC" ]; then \
      sed -i -E '/^Components:/ { /non-free-firmware/! s/$/ non-free-firmware/ }' "$SRC"; \
      grep -q non-free-firmware "$SRC" || { echo "ERROR: failed to enable non-free-firmware component in $SRC" >&2; exit 1; }; \
      echo "OK: non-free-firmware component enabled (deb822 $SRC)"; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i -E '/^deb /{ /non-free-firmware/! s/$/ non-free-firmware/ }' /etc/apt/sources.list; \
      echo "OK: non-free-firmware component enabled (legacy /etc/apt/sources.list)"; \
    else \
      echo "ERROR: no recognized apt sources file — cannot enable non-free-firmware for firmware-*/profile packages (Gap 3)" >&2; exit 1; \
    fi

# -----------------------------------------------------------------------------
# Layer A4 — profile package overlay (Gap 3 fix, packaging audit 2026-07-07).
# `base/profiles/*.yaml`'s `packages.include` (e.g. edge-pro.yaml's hostapd/
# wireless-regdb/firmware-*/modemmanager/libqmi-utils/libmbim-utils/
# usb-modeswitch) were DEAD: this Containerfile only ever REFERENCED profiles in
# comments; nothing parsed or installed them, so no bootc edge image ever got
# Wi-Fi AP, radio firmware, or cellular modem support. Fixed here by parsing THIS
# build's `${PROFILE}.yaml` `packages.include` list and apt-get installing exactly
# those packages.
#
# Deliberately NOT a full YAML parser: the schema is hand-authored by this same
# team and stable (`packages:` / 2-space `include:` / 4-space `- pkg[  # comment]`
# list items / 2-space `exclude:` terminator) — awk/sed already ship in the base
# image (no new build dependency, unlike pulling in python3-yaml or a `yq`
# binary). Verified against ALL FIVE current profiles (2026-07-07): correctly
# extracts cloud/dev/edge-lite/edge-pro/virtual's include lists, strips inline
# `# comments` (cloud.yaml/dev.yaml/virtual.yaml have them), and stops cleanly at
# `exclude:`.
#
# `packages.exclude` is intentionally NOT applied here: because installs are
# per-profile (only THIS profile's own include list is ever installed), a profile
# can never receive another profile's excluded packages in the first place —
# `exclude:` stays documentation-only, exactly as honest as it was before this
# fix (no regression: cloud/virtual never installed hostapd anyway).
#
# A profile with an empty/absent `packages.include` (todays's dev/cloud/virtual
# already have small real lists) degrades to "nothing to install" rather than a
# build failure.
# -----------------------------------------------------------------------------
COPY base/profiles/  /usr/share/hookprobe/profiles/
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    set -eux; \
    PROFILE_FILE="/usr/share/hookprobe/profiles/${PROFILE}.yaml"; \
    if [ ! -f "$PROFILE_FILE" ]; then \
      echo "ERROR: no such profile file: ${PROFILE_FILE} (PROFILE=${PROFILE}) — base/profiles/*.yaml must match --build-arg PROFILE" >&2; \
      exit 1; \
    fi; \
    awk ' \
      /^packages:/ { inp=1; next } \
      inp && /^  include:/ { inc=1; next } \
      inp && /^  exclude:/ { inc=0; inp=0; next } \
      inc && /^    - / { \
        line=$0; \
        sub(/^    - /, "", line); \
        sub(/#.*/, "", line); \
        gsub(/^[ \t]+|[ \t]+$/, "", line); \
        if (length(line) > 0) print line; \
      } \
    ' "$PROFILE_FILE" > /tmp/profile-packages.txt; \
    echo "profile ${PROFILE}: packages.include ="; cat /tmp/profile-packages.txt; \
    if [ -s /tmp/profile-packages.txt ]; then \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive xargs -a /tmp/profile-packages.txt apt-get install -y --no-install-recommends; \
    else \
      echo "profile ${PROFILE}: packages.include is empty — nothing to install"; \
    fi; \
    rm -f /tmp/profile-packages.txt; \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Layer B2 — bootc + bootupd (ADR 0019 D2, Phase 1 — the actual compiled binaries
# Debian's apt cannot provide). Compiled in the dedicated `bootc-tools` stage above
# so the Rust toolchain never lands in the final image. Always produces a file at
# these paths (COPY --from would otherwise fail the build outright): a real
# binary when a networked build compiled one, an HONEST STUB that errors loudly
# when SKIP_GITHUB_DL suppressed the compile (never a silent no-op).
# -----------------------------------------------------------------------------
COPY --from=bootc-tools /out/bootc     /usr/bin/bootc
COPY --from=bootc-tools /out/bootupd   /usr/bin/bootupd
RUN chmod 0755 /usr/bin/bootc /usr/bin/bootupd \
 && ( /usr/bin/bootc --version && echo "OK: bootc --version ran (Layer B2)" ) \
    || echo "WARNING: bootc --version failed in Layer B2 (expected if this was a SKIP_GITHUB_DL / no-egress build — see the stub's own error above; Layer K's lint step reflects this honestly too, non-fatal here for the same reason wasmtime/cosign are)"

# -----------------------------------------------------------------------------
# Layer B — wasmtime: the Wasm/WASI runtime for `runtime: wasm` modules
# (detection / policy / enrichment — the default per Pillar 2). Not packaged in
# Debian, so install the pinned upstream release. The supervisor embeds Wasmtime
# as a LIBRARY (the one that actually loads/runs/precompiles every module and
# every `.cwasm`, ADR 0009/0016/0017); this standalone CLI is a host-level
# operator convenience (`wasmtime --version`, ad hoc inspection) — it NEVER
# touches a module's `.wasm`/`.cwasm` at runtime, so its version is unrelated to
# AOT compatibility EXCEPT that ADR 0017 D3 deliberately keeps it in lockstep
# with the embedded crate's version (WASMTIME_VERSION, asserted in stage `build`
# above) so the two never drift apart and confuse an operator debugging by hand.
#
# F9 fix (verify the verifier): wasmtime publishes NO checksums manifest for its
# release tarballs (every asset name on the v29.0.1 release was enumerated to
# confirm this — only the raw archives ship, no SHA256SUMS/.sha256/immutable-
# release digest; the naming convention is unchanged as of the ADR 0017
# reconciliation to v27.0.0, but re-verify before trusting an unverified future
# bump). So verification here is against an EXPLICIT expected sha256 per
# arch (WASMTIME_SHA256_*, empty by default — see the ARG block above for how to
# compute a real one). Fails the build closed on a mismatch OR on an unset
# expected hash, unless SKIP_GITHUB_DL is set (the existing offline escape hatch).
# -----------------------------------------------------------------------------
RUN set -eux; \
    case "${TARGETARCH}" in \
      arm64)   WT_ARCH=aarch64;    WT_SHA256="${WASMTIME_SHA256_AARCH64}" ;; \
      amd64)   WT_ARCH=x86_64;     WT_SHA256="${WASMTIME_SHA256_X86_64}" ;; \
      riscv64) WT_ARCH=riscv64gc;  WT_SHA256="${WASMTIME_SHA256_RISCV64GC}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    if [ -n "${SKIP_GITHUB_DL}" ]; then echo "SKIP_GITHUB_DL set → not fetching wasmtime (image will lack the Wasm runtime)"; exit 0; fi; \
    if [ -z "$WT_SHA256" ]; then \
      echo "ERROR: no pinned WASMTIME_SHA256_* for TARGETARCH=${TARGETARCH} (wasmtime v${WASMTIME_VERSION} has no upstream checksums file to verify against, so this repo requires an explicit pin). Compute it once with:" >&2; \
      echo "  curl -fsSL -o w.tar.xz https://github.com/bytecodealliance/wasmtime/releases/download/v${WASMTIME_VERSION}/wasmtime-v${WASMTIME_VERSION}-${WT_ARCH}-linux.tar.xz && sha256sum w.tar.xz" >&2; \
      echo "then pass --build-arg WASMTIME_SHA256_$(echo "$WT_ARCH" | tr '[:lower:]' '[:upper:]')=<hash>, or set SKIP_GITHUB_DL=1 to build without wasmtime." >&2; \
      exit 1; \
    fi; \
    url="https://github.com/bytecodealliance/wasmtime/releases/download/v${WASMTIME_VERSION}/wasmtime-v${WASMTIME_VERSION}-${WT_ARCH}-linux.tar.xz"; \
    curl -fsSL --retry 6 --retry-all-errors --retry-delay 3 --connect-timeout 20 "$url" -o /tmp/wasmtime.tar.xz; \
    echo "${WT_SHA256}  /tmp/wasmtime.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/wasmtime.tar.xz -C /tmp; \
    install -m0755 "/tmp/wasmtime-v${WASMTIME_VERSION}-${WT_ARCH}-linux/wasmtime" /usr/bin/wasmtime; \
    rm -rf /tmp/wasmtime*; \
    /usr/bin/wasmtime --version

# -----------------------------------------------------------------------------
# Layer C — cosign: verifies module + manifest signatures ON DEVICE against the
# crypto policy in the Platform Manifest (ADR 0002 `module_signing`). Signing
# keys NEVER ship in the image (ADR 0002 §5 — devices only VERIFY). The image's
# own signature is verified by bootc at upgrade time via the policy in Layer H.
#
# F9 fix (verify the verifier): cosign DOES publish a `cosign_checksums.txt` per
# release (unlike wasmtime) — fetch it alongside the binary and verify the exact
# asset line with `sha256sum -c` before chmod/install. No hash needs pinning in
# this Containerfile; the checksums manifest itself is the pin, fetched fresh
# every build from the exact tagged release. Fails the build closed on mismatch
# or on a missing/malformed manifest line, unless SKIP_GITHUB_DL is set.
# TODO: track sigstore PQC (composite ML-DSA) roadmap for the on-device verifier.
# -----------------------------------------------------------------------------
RUN set -eux; \
    if [ -n "${SKIP_GITHUB_DL}" ]; then echo "SKIP_GITHUB_DL set → not fetching cosign (image will lack the signature verifier)"; exit 0; fi; \
    case "${TARGETARCH}" in arm64) CS_ARCH=arm64 ;; amd64) CS_ARCH=amd64 ;; *) CS_ARCH="${TARGETARCH}" ;; esac; \
    base="https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}"; \
    curl -fsSL --retry 6 --retry-all-errors --retry-delay 3 --connect-timeout 20 "${base}/cosign-linux-${CS_ARCH}" -o /tmp/cosign-bin; \
    curl -fsSL --retry 6 --retry-all-errors --retry-delay 3 --connect-timeout 20 "${base}/cosign_checksums.txt" -o /tmp/cosign_checksums.txt; \
    line="$(grep -E "[[:space:]]cosign-linux-${CS_ARCH}\$" /tmp/cosign_checksums.txt || true)"; \
    if [ -z "$line" ]; then echo "ERROR: cosign_checksums.txt has no entry for cosign-linux-${CS_ARCH} — refusing to trust an unverifiable binary" >&2; exit 1; fi; \
    ( cd /tmp && echo "$line" | sed 's#cosign-linux-'"${CS_ARCH}"'#cosign-bin#' | sha256sum -c - ); \
    install -m0755 /tmp/cosign-bin /usr/bin/cosign; \
    rm -f /tmp/cosign-bin /tmp/cosign_checksums.txt; \
    /usr/bin/cosign version

# -----------------------------------------------------------------------------
# Layer D — the host-integral HookProbe binaries (from stage `build`).
# These live in /usr (immutable rootfs). bootstrap runs ONCE at first boot;
# supervisor is the long-running reconciler (Architecture C9–C11).
# -----------------------------------------------------------------------------
COPY --from=build /out/hookprobe-bootstrap  /usr/lib/hookprobe/hookprobe-bootstrap
COPY --from=build /out/hookprobe-supervisor /usr/lib/hookprobe/hookprobe-supervisor
RUN chmod 0755 /usr/lib/hookprobe/hookprobe-bootstrap /usr/lib/hookprobe/hookprobe-supervisor

# Helper scripts the systemd units ExecStart (firstboot data, cellular, trust-reconcile).
# Installed 0755 to /usr/lib/hookprobe (the unit ExecStart paths) — the chmod also fixes
# the missing exec bit on trust-reconcile.sh. (modules/ovs/config/ moved to Layer D2 below —
# it is now a registry-driven `ovs` module artifact, ADR 0015, not a hand COPY here.)
COPY base/scripts/        /usr/lib/hookprobe/
RUN chmod 0755 /usr/lib/hookprobe/*.sh

# Some callers reference the binaries on $PATH at /usr/bin (greenboot check, fleet agent,
# trust-reconcile default); symlink so both the /usr/lib and /usr/bin paths resolve.
RUN ln -sf /usr/lib/hookprobe/hookprobe-supervisor /usr/bin/hookprobe-supervisor \
 && ln -sf /usr/lib/hookprobe/hookprobe-bootstrap  /usr/bin/hookprobe-bootstrap

# -----------------------------------------------------------------------------
# Layer D2 — EVERY registry-driven module's artifacts (ADR 0015 D2 — the bootc-parity
# fix). Two lines: the assembled tree from stage `build` (every staged module's `.wasm`/
# native binary/`.bpf.o` + units + module.yaml/module.sig registry mirror — see
# builder/generated/staging-plan.json for exactly what's in it) + the GENERATED module
# preset. This REPLACES what used to be ~12 hand `COPY --from=build` + `COPY modules/*`
# lines covering ONLY napse/qsecbit/dnsxai/aegis-guard — every other registry-complete
# module (napse-capture, napse-quarantine, senzorium-flow, host-telemetry, evidence, ovs)
# was silently absent from this image ("hollow bootc SOC", ADR 0015 context). Because
# build-arm64.sh and build-vm.sh consume the SAME plan via the SAME stage-apply.sh, the
# arm64/amd64/bootc images now stage the IDENTICAL (by id) module set — parity is
# structural, not a second hand-list (D2).
#
# Layout matches `wasm_loader::locate_wasm`'s on-device convention (flat `<id>.wasm`
# directly under the modules dir) and `discover_modules`'/`module_sig`'s convention
# (`<id>/module.yaml` + `<id>/module.sig`) — both read the SAME `--modules
# /usr/lib/hookprobe/modules` passed by the units below and by hookprobe-supervisor.service.
#
# `.cwasm` (AOT) IS baked in here (ADR 0017 — supersedes the earlier "intentionally not baked"
# note): the build stage precompiles it NATIVE to this arch (no cross-AOT — the stage already
# runs AS ${TARGETARCH}) and `gen-staging.sh`'s `optional` install action stages it right beside
# each module's `.wasm`. Its digest is pinned in the SAME signed `module.yaml` (`role: aot`,
# arch-qualified) the `.wasm` digest already rides in, so deserializing it is exactly as
# trustworthy as compiling the `.wasm` — never a writable-partition trust surface. A module
# built for an arch whose CI run hasn't landed yet, or one that ships no AOT at all, simply
# falls back to the verified `.wasm` JIT floor (ADR 0016 Fix A) at runtime — safe, just slower.
# -----------------------------------------------------------------------------
COPY --from=build /out/tree/                       /
COPY --from=build /out/85-hookprobe-modules.preset  /usr/lib/systemd/system-preset/85-hookprobe-modules.preset
# Release trust store (security F2/F3 fix — unify the trust path): ONE canonical, RO
# location, `/usr/share/hookprobe/trust/` (under Layer E's read-only /usr/share, covered
# by the image signature — never `/var`, which is writable and would let a tampered
# manifest/module bypass verification). Populated by `builder/sign-release.sh` into
# `builder/trust/release.pub` (see builder/RUNBOOK.md "One-time keys" + builder/README.md
# "Trust store must be baked") — a deterministic DEV key stand-in here; production CI
# replaces it with the real off-device release-HSM public key at sign time (never a
# private key). NOT a module.yaml artifact — it is the trust ANCHOR every module.sig
# verifies against, not a module itself (same rationale as build-arm64.sh/build-vm.sh's
# hand-staging of it). `hookprobe-supervisor.service` + every `--run-wasm` unit pass
# `--trust /usr/share/hookprobe/trust` explicitly so they can never fall back to a
# writable/absent default.
COPY builder/trust/                   /usr/share/hookprobe/trust/

# -----------------------------------------------------------------------------
# Layer E — signed static id→capability tables (RO), shipped in /usr/share.
# Architecture C1/C4–C6: the classifier match keys (platforms/*.yaml), the
# normative manifest JSON Schema (ADR 0003), and the crypto policy live read-only
# in the image and are covered by the image signature (so they are tamper-evident).
# These are COPIED unchanged from the repo; the base build never edits them.
# -----------------------------------------------------------------------------
COPY platforms/                 /usr/share/hookprobe/platforms/
COPY manifest/schema/           /usr/share/hookprobe/schema/
# Embedded offline GeoIP country DB (ADR 0034 Feature 1): ODC-PDDL sapics user-country CSVs feed
# regdomain-apply.sh's offline Wi-Fi-regdomain HINT (public WAN IP → country, no network, no leak).
COPY base/data/ip-location-db/*.csv.gz  /usr/share/hookprobe/geoip/
# TODO: emit the CBOM at build time (security/) and COPY it to the path the
#       manifest's crypto.cbom field references: /usr/share/hookprobe/cbom.json

# -----------------------------------------------------------------------------
# Layer E2 — boot/login identity (ADR 0006), build-path parity fix (2026-07-07). Was staged
# ONLY by builder/mkosi-arm64/build-arm64.sh; this bootc path (and build-vm.sh's amd64 leg,
# fixed alongside this) silently shipped a bare Debian identity instead. `os-release` brands
# the device as HookProbe OS (ID=hookprobe, ID_LIKE=debian) to the operator, compliance
# scanners, and any systemd-sysext extension-release matching; `issue`/`issue.net` is the
# pre-login console/SSH banner; `10-hookprobe` is the dynamic Organism-Status MOTD (pam_motd
# runs /etc/update-motd.d/* on Debian). Plymouth splash is intentionally NOT added here (no
# `plymouth` package in this Containerfile's apt list — headless UEFI/cloud tier, unlike
# build-arm64.sh's Pi image with a display) — that split is deliberate, not an oversight.
COPY base/config/os-release                       /usr/lib/os-release
COPY base/config/issue                            /etc/issue
COPY base/config/issue                            /etc/issue.net
COPY base/config/update-motd.d/10-hookprobe       /etc/update-motd.d/10-hookprobe
RUN chmod 0755 /etc/update-motd.d/10-hookprobe

# -----------------------------------------------------------------------------
# Layer F — BASE systemd units + cgroup slices (Architecture C3/C8/C15, §4.3).
# Units ship in /usr/lib/systemd/system (immutable). We bake the enablement as a
# preset so first boot starts them deterministically without an `enable` at runtime.
#
# ADR 0015: every MODULE's units (ovs/napse/qsecbit/dnsxai/aegis-guard/napse-capture/
# napse-quarantine/senzorium-flow/host-telemetry/evidence) already landed via Layer D2's
# `COPY --from=build /out/tree/ /` above — this layer copies ONLY the base/units/ + the
# BASE preset (80-hookprobe.preset, module-enable lines now split into the generated
# preset already copied in Layer D2, C4).
# -----------------------------------------------------------------------------
COPY base/units/            /usr/lib/systemd/system/
COPY base/config/presets/   /usr/lib/systemd/system-preset/
# 2026-07-07 platform-alignment: the resource-budget slice (base/sysext/) + the resolved
# LLMNR/mDNS hardening drop-in (base/config/) — the SAME SOC parity the mkosi builds carry. Without
# the slice the 6 dataplane units (napse*/senzorium/ovs) resolve Slice= to a default-weight implicit
# slice, silently dropping the capture/enforce priority; without the resolved conf LLMNR is exposed
# on :5355 across every interface incl. the WAN uplink. Both were missing from ALL build paths.
COPY base/sysext/hookprobe-dataplane.slice       /usr/lib/systemd/system/
COPY base/config/60-hookprobe-hardening.conf     /etc/systemd/resolved.conf.d/
RUN systemctl preset-all || true   # apply 80-hookprobe.preset + 85-hookprobe-modules.preset (best-effort at build)

# greenboot boot-health checks (the SOC verdict gate) must be executable on the health path.
COPY base/greenboot/check/  /usr/lib/greenboot/check/
RUN chmod -R 0755 /usr/lib/greenboot/check/ 2>/dev/null || true

# -----------------------------------------------------------------------------
# Layer G — kargs + sysctls. kargs are read by bootc from /usr/lib/bootc/kargs.d
# (applied to the boot entry); sysctls tune the dataplane/eBPF runtime.
# -----------------------------------------------------------------------------
COPY base/config/kargs.d/   /usr/lib/bootc/kargs.d/
COPY base/config/sysctl.d/  /usr/lib/sysctl.d/

# -----------------------------------------------------------------------------
# Layer H — container signature policy (cosign signed-by). The device trusts ONLY
# images/modules signed by the HookProbe release identity. The PUBLIC trust config
# ships here; the public key/identity is injected by CI (never a private key).
# -----------------------------------------------------------------------------
COPY base/config/containers/  /etc/containers/
# TODO: CI injects the cosign public key / sigstore identity referenced by
#       /etc/containers/policy.json into /etc/pki/hookprobe/ (public material only).

# Default operator intents. Shipping the network intent to /etc/hookprobe/network.yaml
# gives the operator a documented, editable starting point (/etc is writable, edited in
# place) — it is NOT required for the reconcile unit to fire (2026-07-05 P1 #4 fix:
# hookprobe-network-reconcile.service no longer `ConditionPathExists`s this file; an
# absent network.yaml reconciles with `NetworkIntent::default()`, the same safe-defaults
# floor every individual intent section already falls back to when omitted).
COPY base/config/network.example.yaml   /etc/hookprobe/network.yaml
COPY base/config/cellular.example.yaml   /etc/hookprobe/cellular.yaml

# -----------------------------------------------------------------------------
# Layer I — persistent data partition vs immutable rootfs split.
# bootc gives an immutable /usr; /etc and /var are writable state. HookProbe puts
# ALL telemetry/evidence/secrets/manifest on a SEPARATE persistent data partition
# mounted at /var/lib/hookprobe so `bootc upgrade`/rollback never touches it
# (Readme "Data & retention"; ADR 0003 — manifest lives here, NOT on rootfs).
#   - tmpfiles.d creates the mountpoint + subdirs with correct perms/ownership.
#   - var-lib-hookprobe.mount (in base/units/) binds the partition labelled
#     `hookprobe-data`; bootc-image-builder creates that partition per profile.
# /run/hookprobe holds the runtime sockets (tmpfs; recreated each boot).
# -----------------------------------------------------------------------------
COPY base/config/tmpfiles.d/  /usr/lib/tmpfiles.d/

# -----------------------------------------------------------------------------
# Layer J — rootless Podman plumbing for `runtime: container` modules.
# Subuid/subgid ranges + storage config so Quadlet services run rootless.
# TODO: confirm the service account model (dedicated `hookprobe` user vs per-module
#       users) once the supervisor's container-launch path is implemented (Phase 2).
# -----------------------------------------------------------------------------
RUN set -eux; \
    if ! getent group hookprobe >/dev/null; then groupadd -r hookprobe; fi; \
    if ! id hookprobe >/dev/null 2>&1; then \
      useradd -r -g hookprobe -d /var/lib/hookprobe -s /usr/sbin/nologin hookprobe; \
    fi; \
    # subordinate id ranges for rootless containers
    grep -q '^hookprobe:' /etc/subuid || echo 'hookprobe:200000:65536' >> /etc/subuid; \
    grep -q '^hookprobe:' /etc/subgid || echo 'hookprobe:200000:65536' >> /etc/subgid

# -----------------------------------------------------------------------------
# Layer K — lint. `bootc container lint` catches image-mode footguns (e.g. a
# non-empty /var baked into the image, missing kernel, bad /etc). Fail the build
# in CI on lint errors.
#
# ADR 0019 D2 update: the base is no longer fictional (`docker.io/library/
# debian:trixie`, real + pullable) and `bootc` is now built in-image (Layer B2)
# instead of missing entirely — the ORIGINAL blocker this TODO named ("upstream
# base availability is a TBD") is resolved. Still left NON-FATAL here, honestly,
# for a narrower reason: this box's `podman build` RUN steps cannot reach
# github.com/deb.debian.org (verified 2026-07-05 — see Layer B2/bootc-tools
# comments), so `bootc container lint` has not actually been exercised against a
# real bootc-compiled image in THIS environment yet. TODO(release-engineer):
# once a networked CI run produces a real `bootc`-carrying image and this passes
# clean, promote to a hard gate (ADR 0019 Phase 1 gate: "bootc container lint
# passes as a hard gate") — do not flip it on the strength of an unverified guess.
# -----------------------------------------------------------------------------
RUN bootc container lint || echo "WARNING: bootc container lint not run / not fatal yet (ADR 0019 Phase 1 — promote to a hard CI gate once verified clean on a networked build)"

# bootc/ostree require an empty /var in the image (state is created at boot from
# tmpfiles + the mounted data partition). Ensure nothing leaked into /var.
RUN rm -rf /var/lib/apt/lists/* /var/cache/* && ( [ -z "$(ls -A /var/lib 2>/dev/null | grep -v -e '^$')" ] || true )
