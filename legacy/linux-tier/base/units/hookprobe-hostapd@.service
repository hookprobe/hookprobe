[Unit]
Description=HookProbe Wi-Fi AP (hostapd) on %i
Documentation=file:///usr/share/hookprobe/docs/architecture/network-fabric.md
# Serves the onboard radio (%i, e.g. wlan0) as the trusted-bubble AP. The config is GENERATED
# by the AEGIS reconcile (wifi_cfg → /etc/hostapd/hostapd-%i.conf) and installed by network-apply.
# Only run when the generated config + the radio + hostapd exist. NOTE: do NOT order
# After=hookprobe-network-reconcile.service — network-apply (which runs INSIDE that reconcile's
# ExecStartPost) starts this unit directly, so an After= on the reconcile is a circular wait
# (reconcile → systemctl start hostapd → After=reconcile → deadlock). The config-exists condition
# is the real ordering guarantee.
After=sys-subsystem-net-devices-%i.device
# ADR 0034: the regdomain MUST be set (iw reg set + hostapd country_code) BEFORE the radio comes
# up — setting it at runtime triggers the brcmfmac DFS bounce (ch40/80 → ch140/20 collapse). The
# network reconcile that renders this conf already runs After hookprobe-regdomain; this explicit
# After=/Wants= guarantees it even if hostapd is started by some other path.
After=hookprobe-regdomain.service
Wants=hookprobe-regdomain.service
ConditionPathExists=/etc/hostapd/hostapd-%i.conf
ConditionPathExists=/usr/sbin/hostapd

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd /etc/hostapd/hostapd-%i.conf
Restart=on-failure
RestartSec=5
# hostapd needs net_admin to bring the radio up + program the AP; nothing else.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/run
# 2026-07-07 backend-audit fix: no Slice= meant the AP radio daemon ran unaccounted in
# system.slice; it's dataplane, matching napse-dpi/napse-quarantine/hookprobe-ovs.
Slice=hookprobe-dataplane.slice

[Install]
WantedBy=multi-user.target
