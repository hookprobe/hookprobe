# hookprobe-supervisor.service — the long-running reconciler (Architecture C9–C11, §4.4).
# Reads the signed Platform Manifest (RO), resolves each module's requires/grants/
# provides, loads Wasm (Wasmtime epoch + StoreLimits) and rootless-Podman/Quadlet
# services within their budgets, and reconciles to desired state level-triggered +
# idempotent. It also serves the RO manifest socket and owns the admin-only RW
# control socket. Type=notify with a watchdog driven from the real work loop (C15).

[Unit]
Description=HookProbe supervisor / AEGIS deterministic reconciler
Documentation=https://github.com/hookprobe/hookprobe-os/blob/main/docs/architecture/Architecture.md

# A manifest must exist first (bootstrap produces it). Wants (not Requires) so the
# supervisor still comes up degraded if bootstrap failed — it then serves the last
# cached signed manifest and shows a degraded badge (ADR 0003 §exposure).
Wants=hookprobe-bootstrap.service var-lib-hookprobe.mount
After=hookprobe-bootstrap.service var-lib-hookprobe.mount network.target

# Restart-storm guard (C15): cap restarts so a crash-loop can't burn an SD card or
# mask a persistent fault. These belong in [Unit] for the start-limit accounting.
StartLimitIntervalSec=300
StartLimitBurst=5

# The shipping supervisor performs ONE level-triggered, idempotent reconcile pass per
# activation (no internal loop / sd_notify yet), so it runs as a oneshot that stays
# "active" after a successful pass. TODO: when the binary grows a real reconcile loop,
# switch back to Type=notify + NotifyAccess=main + WatchdogSec=30s fed from that loop.
[Service]
Type=oneshot
RemainAfterExit=yes

# CLI: the manifest is a POSITIONAL argument; --modules locates the module dir. There is
# no --manifest/--schema flag — the schema ships read-only and is enforced in-code; the
# manifest's own signature is verified on load (a tampered one is refused).
#
# --modules + --trust BOTH point at the read-only rootfs (security F2/F3 fix — unify the
# trust path): modules ship baked at /usr/lib/hookprobe/modules (matches every --run-wasm
# unit's convention — dnsxai/aegis-guard/napse/qsecbit .service — and wasm_loader.rs's
# on-device layout) and the release trust anchor ships at /usr/share/hookprobe/trust
# (base/Containerfile Layer D2, greenboot's 10-hookprobe-soc.sh use the SAME path). Never
# /var/lib/hookprobe/* for either — that partition is operator/reconciler-writable, so
# loading an anchor or module from there would make signature verification a formality,
# not a check (a compromised writer could plant its own "trusted" key).
ExecStart=/usr/lib/hookprobe/hookprobe-supervisor \
    /var/lib/hookprobe/manifest.json \
    --modules /usr/lib/hookprobe/modules \
    --trust /usr/share/hookprobe/trust

# Restart policy.
Restart=on-failure
RestartSec=2s

# --- placement: the high-priority LIVE slice (Architecture §4.3) -------------
# The supervisor + live detection path run here; CPU/IO weighted ABOVE the
# background slice so retention compaction / model pulls never starve enforcement.
Slice=hookprobe-live.slice

# --- runtime sockets are socket-activated (see hookprobe-manifest.socket etc.) -
# RO manifest socket is world-readable; RW control socket is admin-only (0600).

# --- unit hardening (C15 "unit hardening"; the supervisor is a network-reachable
#     control-plane service, so it gets a tight sandbox). It needs to talk to the
#     host bridge (OVS, Podman) — kept narrow; broaden deliberately, not by default.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# ^ MDWE must stay OFF: Wasmtime JITs code (writable→executable mappings).
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @raw-io

# Writable paths: only the data partition state + the runtime socket dir.
ReadWritePaths=/var/lib/hookprobe
RuntimeDirectory=hookprobe
RuntimeDirectoryMode=0755
StateDirectory=hookprobe

# Capabilities: minimal. Host-integral actions (OVS flow programming, Podman,
# mounts) funnel through ONE narrow privileged OS-Agent bridge (Architecture §4.4),
# NOT by granting the supervisor broad caps. TODO: enumerate the exact bridge IPC.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
