[Unit]
Description=HookProbe secrets on the encrypted data volume (SSH host keys → dm-crypt) — ADR 0007 E2
Documentation=https://github.com/hookprobe/hookprobe-os/blob/main/docs/adr/0007-data-at-rest-encryption.md
DefaultDependencies=no
# After the data volume is guaranteed encrypted-or-tmpfs (data-guard); BEFORE sshd reads its host keys.
After=hookprobe-data-guard.service var-lib-hookprobe.mount
Wants=hookprobe-data-guard.service
Before=ssh.service sshd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/hookprobe/secrets-init.sh

[Install]
WantedBy=multi-user.target
