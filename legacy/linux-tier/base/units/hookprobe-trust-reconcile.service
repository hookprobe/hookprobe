[Unit]
Description=HookProbe continuous-trust reconcile (posture → dynamic quarantine)
Documentation=file:///usr/share/hookprobe/docs/architecture/network-segmentation.md
# Needs the data partition (manifest, arp-status, blocked_macs, quarantine state) and OVS.
After=var-lib-hookprobe.mount hookprobe-ovs.service
Wants=hookprobe-ovs.service
ConditionPathExists=/var/lib/hookprobe/manifest.json

[Service]
Type=oneshot
# Read-only on everything except the OVS flow table + the quarantine state file.
ExecStart=/usr/lib/hookprobe/trust-reconcile.sh
Nice=10
# Hardening: this only needs to read /var/lib/hookprobe and run ovs-ofctl.
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/hookprobe
PrivateTmp=yes
