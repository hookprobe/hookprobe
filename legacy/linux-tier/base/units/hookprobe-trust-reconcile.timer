[Unit]
Description=Run the HookProbe continuous-trust reconcile every 30s
Documentation=file:///usr/share/hookprobe/docs/architecture/network-segmentation.md

[Timer]
# First run shortly after boot, then every 30s. Continuous trust = re-evaluate often;
# quarantine takes effect within one interval and reverts within one of posture clearing.
OnBootSec=45s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=hookprobe-trust-reconcile.service

[Install]
WantedBy=timers.target
