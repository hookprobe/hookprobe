[Unit]
Description=HookProbe AEGIS network reconcile (intent → all network artifacts)
Documentation=file:///usr/share/hookprobe/docs/architecture/network-fabric.md
# Reconciles /etc/hookprobe/network.yaml against the signed manifest into the staging
# dir; the per-domain apply units (networkd, hostapd, hookprobe-ovs) consume from there.
# After bootstrap so the SIGNED manifest exists before we check the condition (else the
# unit is skipped on first boot, when bootstrap hasn't written the manifest yet).
#
# 2026-07-05 FIX (backend-audit P1 #4 — "network.yaml single-point-of-failure"): this used
# to ALSO `ConditionPathExists=/etc/hookprobe/network.yaml`, gating the ENTIRE reconcile
# (including the mirror/fabric bring-up that has nothing to do with operator overrides) on
# that one optional file's mere existence — a device that never wrote/shipped a network.yaml
# got NO network reconcile at all, not even the manifest-derived safe defaults. Removed: the
# supervisor's own `--reconcile-network` now falls back to `NetworkIntent::default()` (safe
# defaults: auto fabric, idle Wi-Fi, manifest WAN order, …) when the file is absent — "omit
# the file" is now handled exactly like "omit one section" already was. A file that exists
# but fails to PARSE is still a hard failure (this unit then fails loudly, as before); only
# genuine absence (ENOENT) is treated as "use defaults".
After=var-lib-hookprobe.mount hookprobe-bootstrap.service
Wants=hookprobe-bootstrap.service
# ADR 0034: run the regdomain oneshot FIRST so /run/hookprobe/wifi-country exists (and `iw reg set`
# is already applied) before this reconcile renders hostapd's country_code and starts hostapd —
# setting the regdomain after hostapd is serving triggers the brcmfmac DFS bounce.
After=hookprobe-regdomain.service
Wants=hookprobe-regdomain.service
ConditionPathExists=/var/lib/hookprobe/manifest.json

[Service]
Type=oneshot
RemainAfterExit=yes
# Generate every artifact from one intent. Staging dir under /run (tmpfs, regenerated).
ExecStartPre=/usr/bin/mkdir -p /run/hookprobe/network
ExecStart=/usr/bin/hookprobe-supervisor /var/lib/hookprobe/manifest.json \
  --reconcile-network /etc/hookprobe/network.yaml \
  --network-write /run/hookprobe/network
# Apply the staged artifacts to their live locations (networkd / hostapd / OVS). Without
# this the reconcile would only STAGE files and nothing would take effect.
ExecStartPost=/usr/lib/hookprobe/network-apply.sh
# Verify the manifest signature before trusting it (the supervisor refuses a tampered one).
ProtectHome=yes
ProtectSystem=strict
# The apply step installs networkd units and hostapd configs to their live dirs, so those
# (plus the /run staging dir) must be writable under ProtectSystem=strict. The `-` prefix
# marks a path OPTIONAL: a minimal image without the hostapd package has no /etc/hostapd,
# and a missing ReadWritePaths entry would otherwise fail the unit at 226/NAMESPACE.
#
# 2026-07-07 cross-platform fix: network-apply.sh ALSO installs `ifaces.env` (the resolved
# LAN/WAN/mirror interface names — `aegis::reconcile_network`'s `render_ifaces_env`) to
# /var/lib/hookprobe/ifaces.env, so napse-quarantine/napse-l2guard/scan-responder can bind to
# THIS device's real interfaces instead of a Pi-specific hardcoded default. That write needs
# /var/lib/hookprobe itself writable under ProtectSystem=strict (read access to manifest.json
# there was already unaffected — ProtectSystem only blocks WRITES).
ReadWritePaths=/run/hookprobe -/etc/systemd/network -/etc/hostapd -/etc/systemd/resolved.conf.d -/var/lib/hookprobe
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
