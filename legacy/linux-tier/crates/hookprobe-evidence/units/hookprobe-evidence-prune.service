[Unit]
Description=HookProbe evidence graph retention — prune old nodes/edges + VACUUM (backend-audit gap 1)
Documentation=file:///usr/share/hookprobe/docs/architecture/Architecture.md
After=var-lib-hookprobe.mount
[Service]
Type=oneshot
# Deliberately its OWN unit/timer, NOT folded into hookprobe-evidence.timer's 2-minute ingest
# cadence: --prune ends with a VACUUM (a full-file rewrite) and briefly takes an exclusive DB
# lock (any concurrent open, including hookprobe-api's read-only reader, gets SQLITE_BUSY until
# it completes) -- fine once a day, not something to do every 2 minutes on SD-card-class storage
# or against a dashboard that might be polling. HOOKPROBE_RETENTION_DAYS/HOOKPROBE_MAX_DB_MB are
# read by the binary itself (env fallback, see main.rs) -- override here or via
# /etc/hookprobe/env.d/ if an operator wants a different window/cap than the compiled-in default
# (hookprobe_evidence::DEFAULT_RETENTION_DAYS = 30 days; no size cap unless HOOKPROBE_MAX_DB_MB
# is set).
#Environment=HOOKPROBE_RETENTION_DAYS=30
#Environment=HOOKPROBE_MAX_DB_MB=512
ExecStart=/usr/lib/hookprobe/hookprobe-evidence --db /var/lib/hookprobe/evidence.db --prune
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hookprobe
MemoryMax=128M
# Same home as hookprobe-evidence.service (Architecture.md §4.3): deferrable, low-priority
# maintenance work that must yield to the live detection path under contention, never starve it.
Slice=hookprobe-background.slice
