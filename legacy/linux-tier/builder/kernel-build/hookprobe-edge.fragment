# --- BTF / CO-RE eBPF (the whole point: native /sys/kernel/btf/vmlinux) ---
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y
# not reduced/split — BTF needs full DWARF
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_SPLIT=n
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF_ERR_ON_MISSING=n

# --- mainline RP1 (Pi5/CM5): PCIe root + RP1 MFD endpoint + sub-devices ---
CONFIG_PCI=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y
CONFIG_PCI_DYNAMIC_OF_NODES=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_DYNAMIC=y
CONFIG_MISC_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_COMMON_CLK_RP1=y
# RP1 Gigabit Ethernet = Cadence macb (instantiated by the RP1 overlay)
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_MACB_PCI=y
# RP1 USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_DWC3=y

# --- keep root mountable: storage/USB the Pi needs built-in ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- Broadcom SoC platform bits for bcm2712 ---
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y

# --- page size: keep 4K (generic) for shared-rootfs alignment safety (ADR 0030 D4) ---
CONFIG_ARM64_4K_PAGES=y
