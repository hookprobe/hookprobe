---
/**
 * Shell — HTML document wrapper.
 *
 * Provides: <html>, <head> (charset, viewport, meta, CSS import), <body>.
 * JS is supplied only by the Solid client:load island in index.astro;
 * this layout emits zero script tags of its own.
 */

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title       = 'Mission Control — HookProbe OS',
  description = 'HookProbe OS V2: the operating system. SOC is its default workspace. Hardware only unlocks capabilities.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Dark mode only; never flash white -->
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <!-- Favicon: minimal HookProbe glyph -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
