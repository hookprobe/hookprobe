	(text "RK3588 unit 2. TYPEC0 feeds USB-C port 1, TYPEC1 feeds USB-C port 2 (USB 3 and DisplayPort share\nthe same four pairs). USB20_HOST0 is the USB 2 side of the hub; USB20_HOST1 goes to the Wi-Fi\ncard's Bluetooth. The OTG ID balls are unused (a Type-C port gets its role\nfrom the PD controller); VBUSDET is pulled up on the port sheets. REXT values follow the Radxa Rock 5B v1.45 schematic (sheet 14)."
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "01b0ffe5-cc6d-5fa5-9c53-5c70655fc32e")
	)
