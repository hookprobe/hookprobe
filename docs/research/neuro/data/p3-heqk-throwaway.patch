@@ -0,0 +1,363 @@
+//! THROWAWAY (never committed): P3/P4 of docs/research/neuro/14 — el0-neuro inside heqk under QEMU.
+//! Loads the EL0 server like `hsh.rs`, replays the golden vectors through the REAL ABI (CMD_EVENTS batches,
+//! CMD_CLOSE_HOUR), checks every returned score, proves fault containment, and times every excursion.
+#![allow(dead_code)]
+
+macro_rules! kprint { ($($t:tt)*) => { arch_aarch64::_print(format_args!($($t)*)) }; }
+
+static NEURO_ELF: &[u8] = include_bytes!(concat!(env!("OUT_DIR"), "/el0_neuro.elf"));
+static GOLDEN: &str = include_str!(concat!(env!("CARGO_MANIFEST_DIR"), "/../../neuro/neuro-core/tests/golden.txt"));
+
+// The proposed ABI (os/neuro/el0-neuro/src/abi.rs), QEMU variant.
+const BASE: usize = 0xBE00_0000;
+const IMAGE_MAX: usize = 0x2_0000;
+const STACK_OFF: usize = 0x2_0000;
+const STACK_SIZE: usize = 0x4000;
+const IO_OFF: usize = 0x2_4000;
+const IO_SIZE: usize = 0x4000;
+const H_MAGIC: usize = 0;
+const H_CMD: usize = 4;
+const H_IN_LEN: usize = 8;
+const H_STATUS: usize = 12;
+const H_OUT_LEN: usize = 16;
+const MAGIC: u32 = u32::from_le_bytes(*b"HQNE");
+const IN_OFF: usize = 0x40;
+const IN_MAX: usize = 0x2000;
+const OUT_OFF: usize = 0x2040;
+const OUT_MAX: usize = IO_SIZE - OUT_OFF;
+const CMD_EVENTS: u32 = 1;
+const CMD_CLOSE_HOUR: u32 = 2;
+const CMD_RESET_DEV: u32 = 3;
+const CMD_INFO: u32 = 4;
+const CMD_SELFTEST_FAULT: u32 = 99;
+const ST_OK: u32 = 0;
+const ST_BAD_INPUT: u32 = 3;
+const ST_PANIC: u32 = 6;
+const EV_SIZE: usize = 16;
+const EV_FLOW: u8 = 1;
+const EV_VOLUME: u8 = 2;
+const EV_DNS: u8 = 3;
+const RES_SIZE: usize = 20;
+
+const IO_PAGES: usize = IO_SIZE / 0x1000;
+const STACK_PAGES: usize = STACK_SIZE / 0x1000;
+const RW_MAX: usize = 32; // the 64-device table is ~83 KB of .bss (hsh needs 8)
+const BUDGET_US: u64 = 2_000_000;
+
+struct Server {
+    entry: usize,
+    aspace: crate::el0as::El0As,
+    sp_top: usize,
+    io: [usize; IO_PAGES],
+    rw: [(usize, usize, usize); RW_MAX],
+    nrw: usize,
+    calls: u64,
+    faults: u64,
+    ticks_max: u64,
+}
+
+fn alloc() -> usize {
+    use hal::Mmu as _;
+    arch_aarch64::Mmu.alloc_frame()
+}
+fn map(a: &crate::el0as::El0As, va: usize, pa: usize, exec: bool, write: bool) -> bool {
+    use crate::el0as::Map;
+    a.map(va, pa, if exec { Map::Code } else if write { Map::Data } else { Map::DataRo })
+}
+
+fn load() -> Result<Server, &'static str> {
+    let parsed = crate::elf::parse(NEURO_ELF).map_err(|_| "ELF parse")?;
+    let aspace = crate::el0as::El0As::new().ok_or("no address space")?;
+    let mut s = Server { entry: parsed.entry, aspace, sp_top: BASE + STACK_OFF + STACK_SIZE, io: [0; IO_PAGES], rw: [(0, 0, 0); RW_MAX], nrw: 0, calls: 0, faults: 0, ticks_max: 0 };
+    for g in parsed.segs[..parsed.nsegs].iter() {
+        if g.vaddr < BASE || g.vaddr + g.memsz > BASE + IMAGE_MAX {
+            return Err("segment outside the window");
+        }
+        for p in 0..(g.memsz + 0xFFF) >> 12 {
+            let f = alloc();
+            if f == 0 {
+                return Err("out of frames (image)");
+            }
+            let voff = p * 0x1000;
+            let n = g.filesz.saturating_sub(voff).min(0x1000);
+            unsafe { core::ptr::write_bytes(f as *mut u8, 0, 0x1000) };
+            if n > 0 {
+                unsafe { core::ptr::copy_nonoverlapping(NEURO_ELF.as_ptr().add(g.offset + voff), f as *mut u8, n) };
+            }
+            if g.executable() {
+                arch_aarch64::mmu::sync_instruction_cache(f, 0x1000);
+            } else if g.writable() {
+                if s.nrw == RW_MAX {
+                    return Err("too many RW pages");
+                }
+                s.rw[s.nrw] = (f, g.offset + voff, n);
+                s.nrw += 1;
+            }
+            if !map(&aspace, g.vaddr + voff, f, g.executable(), g.writable()) {
+                return Err("map image page refused");
+            }
+        }
+    }
+    for p in 0..STACK_PAGES {
+        let f = alloc();
+        if f == 0 || !map(&aspace, BASE + STACK_OFF + p * 0x1000, f, false, true) {
+            return Err("map stack refused");
+        }
+    }
+    for p in 0..IO_PAGES {
+        let f = alloc();
+        if f == 0 || !map(&aspace, BASE + IO_OFF + p * 0x1000, f, false, true) {
+            return Err("map IO refused");
+        }
+        s.io[p] = f;
+    }
+    Ok(s)
+}
+
+impl Server {
+    fn write(&mut self, mut off: usize, mut src: &[u8]) {
+        while !src.is_empty() && off < IO_SIZE {
+            let (pg, po) = (off / 0x1000, off % 0x1000);
+            let n = src.len().min(0x1000 - po);
+            unsafe { core::ptr::copy_nonoverlapping(src.as_ptr(), (self.io[pg] + po) as *mut u8, n) };
+            off += n;
+            src = &src[n..];
+        }
+    }
+    fn read(&self, mut off: usize, mut out: &mut [u8]) {
+        while !out.is_empty() && off < IO_SIZE {
+            let (pg, po) = (off / 0x1000, off % 0x1000);
+            let n = out.len().min(0x1000 - po);
+            unsafe { core::ptr::copy_nonoverlapping((self.io[pg] + po) as *const u8, out.as_mut_ptr(), n) };
+            off += n;
+            out = &mut out[n..];
+        }
+    }
+    fn r32(&self, off: usize) -> u32 {
+        let mut b = [0u8; 4];
+        self.read(off, &mut b);
+        u32::from_le_bytes(b)
+    }
+    /// One command; (status, out_len, ticks spent in the excursion incl. entry/exit).
+    fn call(&mut self, cmd: u32, input: &[u8]) -> (u32, usize, u64) {
+        let n = input.len().min(IN_MAX);
+        self.write(H_MAGIC, &MAGIC.to_le_bytes());
+        self.write(H_CMD, &cmd.to_le_bytes());
+        self.write(H_IN_LEN, &(n as u32).to_le_bytes());
+        self.write(H_STATUS, &ST_PANIC.to_le_bytes());
+        self.write(IN_OFF, &input[..n]);
+        self.calls += 1;
+        let t0 = crate::clock::ticks();
+        let how = crate::el0as::excursion(&self.aspace, self.entry, self.sp_top, BUDGET_US);
+        let dt = crate::clock::ticks() - t0;
+        self.ticks_max = self.ticks_max.max(dt);
+        let st = if how == crate::Excursion::Exited { self.r32(H_STATUS) } else { ST_PANIC };
+        if st == ST_PANIC {
+            self.faults += 1;
+            self.reset();
+            return (ST_PANIC, 0, dt);
+        }
+        (st, (self.r32(H_OUT_LEN) as usize).min(OUT_MAX), dt)
+    }
+    fn reset(&mut self) {
+        for i in 0..self.nrw {
+            let (f, off, n) = self.rw[i];
+            unsafe {
+                core::ptr::write_bytes(f as *mut u8, 0, 0x1000);
+                if n > 0 {
+                    core::ptr::copy_nonoverlapping(NEURO_ELF.as_ptr().add(off), f as *mut u8, n);
+                }
+            }
+        }
+        for f in self.io.iter() {
+            unsafe { core::ptr::write_bytes(*f as *mut u8, 0, 0x1000) };
+        }
+    }
+}
+
+fn hex32(s: &str) -> u32 {
+    u32::from_str_radix(s, 16).unwrap_or(0)
+}
+fn num(s: &str) -> i64 {
+    s.parse::<i64>().unwrap_or(-1)
+}
+fn sat16(v: i64) -> u16 {
+    v.clamp(0, 65535) as u16
+}
+
+struct Batch {
+    buf: [u8; IN_MAX],
+    n: usize,
+}
+
+/// P3 + P4: returns true on PASS.
+pub fn selftest() -> bool {
+    let mut s = match load() {
+        Ok(s) => s,
+        Err(why) => {
+            kprint!(" [P-neuro] FAIL — el0-neuro did not load ({})\n", why);
+            return false;
+        }
+    };
+    let freq = crate::clock::freq().max(1);
+    // Warm-up: in this boot-path context a scheduler tick may still be pending at the GIC when the first excursion
+    // unmasks IRQs (the hazard cm5_scheduler_demo documents). Report it, then measure from a clean state.
+    let (w_st, _, w_dt) = s.call(CMD_INFO, &[]);
+    kprint!(" [P-neuro] warm-up excursion: status {} in {} us (a pending stale tick shows as 6 / ~budget)\n", w_st, w_dt * 1_000_000 / freq);
+    s.ticks_max = 0;
+    let faults_warm = s.faults;
+    let (st, len, _) = s.call(CMD_INFO, &[]);
+    let mut info = [0u8; 8];
+    s.read(OUT_OFF, &mut info);
+    let devs = u16::from_le_bytes([info[0], info[1]]);
+    let bpd = u32::from_le_bytes([info[2], info[3], info[4], info[5]]);
+    kprint!(" [P-neuro] el0-neuro loaded at {:#x}: info st={} len={} devices={} bytes/device={} rw_pages={}\n", BASE, st, len, devs, bpd, s.nrw);
+
+    // ---- P3: golden replay through the real ABI ----
+    let mut b = Batch { buf: [0u8; IN_MAX], n: 0 };
+    let (mut closes, mut ok, mut events, mut ev_calls, mut ev_ticks, mut close_ticks, mut close_max) = (0u32, 0u32, 0u64, 0u64, 0u64, 0u64, 0u64);
+    let mut first_bad: Option<(usize, i64, i64)> = None;
+    macro_rules! flush {
+        () => {
+            if b.n > 0 {
+                let (st, _, dt) = s.call(CMD_EVENTS, &b.buf[..b.n]);
+                if st != ST_OK {
+                    kprint!(" [P-neuro] events batch status {}\n", st);
+                }
+                ev_calls += 1;
+                ev_ticks += dt;
+                b.n = 0;
+            }
+        };
+    }
+    macro_rules! push {
+        ($kind:expr, $flags:expr, $dev:expr, $fp:expr, $bytes:expr, $conns:expr) => {{
+            if b.n + EV_SIZE > IN_MAX {
+                flush!();
+            }
+            let (kind, flags, dev, fp, bytes, conns): (u8, u8, u16, u32, u64, u16) = ($kind, $flags, $dev, $fp, $bytes, $conns);
+            let r = &mut b.buf[b.n..b.n + EV_SIZE];
+            r[0] = kind;
+            r[1] = flags;
+            r[2..4].copy_from_slice(&dev.to_le_bytes());
+            r[4..8].copy_from_slice(&fp.to_le_bytes());
+            r[8..14].copy_from_slice(&bytes.to_le_bytes()[..6]);
+            r[14..16].copy_from_slice(&conns.to_le_bytes());
+            b.n += EV_SIZE;
+            events += 1;
+        }};
+    }
+    for (ln, line) in GOLDEN.lines().enumerate() {
+        let mut t = line.split_ascii_whitespace();
+        let Some(tag) = t.next() else { continue };
+        let f: [&str; 9] = core::array::from_fn(|_| t.next().unwrap_or(""));
+        match tag {
+            "R" => {
+                flush!();
+                let dev = num(f[0]) as u16;
+                let _ = s.call(CMD_RESET_DEV, &dev.to_le_bytes());
+            }
+            "F" => push!(EV_FLOW, 0, num(f[0]) as u16, hex32(f[1]), num(f[2]) as u64, num(f[3]) as u16),
+            "N" => push!(EV_VOLUME, 0, num(f[0]) as u16, 0, num(f[1]) as u64, num(f[2]) as u16),
+            "D" => push!(EV_DNS, (f[2] == "1") as u8, num(f[0]) as u16, hex32(f[1]), 0, 1),
+            "C" => {
+                flush!();
+                let (dev, hr) = (num(f[0]), num(f[1]));
+                let (st, len, dt) = s.call(CMD_CLOSE_HOUR, &[hr as u8]);
+                close_ticks += dt;
+                close_max = close_max.max(dt);
+                closes += 1;
+                let mut r = [0u8; RES_SIZE];
+                s.read(OUT_OFF, &mut r);
+                let got_dev = u16::from_le_bytes([r[0], r[1]]) as i64;
+                let score = u32::from_le_bytes([r[4], r[5], r[6], r[7]]) as i64;
+                let parts: [u16; 5] = core::array::from_fn(|i| u16::from_le_bytes([r[8 + 2 * i], r[9 + 2 * i]]));
+                let want_parts: [u16; 5] = core::array::from_fn(|i| sat16(num(f[3 + i])));
+                let good = st == ST_OK && len == RES_SIZE && got_dev == dev && score == num(f[2]) && parts == want_parts;
+                if good {
+                    ok += 1;
+                } else if first_bad.is_none() {
+                    first_bad = Some((ln + 1, num(f[2]), score));
+                }
+            }
+            _ => {} // S/L/P/X are checked by the host test (neuro-core/tests/golden.rs)
+        }
+    }
+    let us = |t: u64| t * 1_000_000 / freq;
+    let bit_exact = closes == 1200 && ok == closes;
+    kprint!(" [P-neuro-golden] {} — {}/{} hour closes bit-exact through the real ABI (CMD_EVENTS x{} batches, {} events; CMD_CLOSE_HOUR x{}){}\n",
+        if bit_exact { "PASS" } else { "FAIL" }, ok, closes, ev_calls, events, closes,
+        if let Some((l, w, g)) = first_bad { alloc_note(l, w, g) } else { "" });
+    if let Some((l, w, g)) = first_bad {
+        kprint!(" [P-neuro-golden] first mismatch: golden line {} want score {} got {}\n", l, w, g);
+    }
+
+    // ---- P3: fault containment ----
+    let (st_bad, _, _) = s.call(CMD_EVENTS, &[1u8; 15]); // not a multiple of 16
+    let mut rec = [0u8; 16];
+    rec[0] = EV_FLOW;
+    rec[2..4].copy_from_slice(&999u16.to_le_bytes()); // device out of range
+    let (st_dev, _, _) = s.call(CMD_EVENTS, &rec);
+    let (st_hr, _, _) = s.call(CMD_CLOSE_HOUR, &[24]);
+    let faults_before = s.faults;
+    let (st_panic, _, _) = s.call(CMD_SELFTEST_FAULT, &[]);
+    let (st_after, _, _) = s.call(CMD_INFO, &[]);
+    let contained = st_bad == ST_BAD_INPUT && st_dev == ST_BAD_INPUT && st_hr == ST_BAD_INPUT
+        && st_panic == ST_PANIC && s.faults == faults_before + 1 && st_after == ST_OK;
+    let _ = faults_warm;
+    kprint!(" [P-neuro-fault] {} — short batch->{} bad device->{} bad hour->{} (want {}); forced panic->{} (want {}) server reset, kernel alive, next INFO->{}\n",
+        if contained { "PASS" } else { "FAIL" }, st_bad, st_dev, st_hr, ST_BAD_INPUT, st_panic, ST_PANIC, st_after);
+
+    // ---- P4 (QEMU proxy): cost ----
+    let ev_ns = if events > 0 { ev_ticks * 1_000_000_000 / freq / events } else { 0 };
+    kprint!(" [P-neuro-cost] QEMU (TCG, NOT timing-faithful): {} events in {} us over {} excursions = {} ns/event incl. excursion entry/exit; hour-close mean {} us, max {} us; largest excursion {} us; budget {} us\n",
+        events, us(ev_ticks), ev_calls, ev_ns, us(close_ticks) / closes.max(1) as u64, us(close_max), us(s.ticks_max), BUDGET_US);
+    // ---- P4 (QEMU proxy): load — 64 devices, full batches, one 64-device hour close ----
+    let (_, _, idle) = s.call(CMD_EVENTS, &[]); // empty excursion = fixed entry/exit overhead
+    let mut idle_min = idle;
+    for _ in 0..20 {
+        let (_, _, d) = s.call(CMD_EVENTS, &[]);
+        idle_min = idle_min.min(d);
+    }
+    for dev in 0..64u16 {
+        let _ = s.call(CMD_RESET_DEV, &dev.to_le_bytes());
+    }
+    let (mut lt, mut ln_ev, mut lbatches, mut lmax) = (0u64, 0u64, 0u64, 0u64);
+    let mut x: u32 = 0x1234_5678;
+    for _hour in 0..3u8 {
+        for _batch in 0..25 {
+            let mut buf = [0u8; IN_MAX];
+            for k in 0..IN_MAX / EV_SIZE {
+                x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+                let r = &mut buf[k * EV_SIZE..(k + 1) * EV_SIZE];
+                let dns = x % 5 == 0;
+                r[0] = if dns { EV_DNS } else { EV_FLOW };
+                r[1] = (dns && x % 50 == 0) as u8;
+                r[2..4].copy_from_slice(&((x >> 8) as u16 % 64).to_le_bytes());
+                r[4..8].copy_from_slice(&(x % 40).wrapping_mul(2654435761).to_le_bytes()); // ~40 peers per device
+                r[8..14].copy_from_slice(&((x % 20_000) as u64).to_le_bytes()[..6]);
+                r[14..16].copy_from_slice(&1u16.to_le_bytes());
+            }
+            let (st, _, d) = s.call(CMD_EVENTS, &buf);
+            if st != ST_OK {
+                kprint!(" [P-neuro-load] batch status {}\n", st);
+            }
+            lt += d;
+            lmax = lmax.max(d);
+            ln_ev += (IN_MAX / EV_SIZE) as u64;
+            lbatches += 1;
+        }
+    }
+    let (cst, clen, ct) = s.call(CMD_CLOSE_HOUR, &[12]);
+    let ns_ev = lt * 1_000_000_000 / freq / ln_ev.max(1);
+    let ns_ev_net = (lt.saturating_sub(idle_min * lbatches)) * 1_000_000_000 / freq / ln_ev.max(1);
+    kprint!(" [P-neuro-load] QEMU (TCG, NOT timing-faithful): {} events in {} batches of {} -> {} ns/event gross, {} ns/event net of the {} us empty-excursion overhead; largest batch excursion {} us; 64-device hour close: status {} ({} devices reported) in {} us\n",
+        ln_ev, lbatches, IN_MAX / EV_SIZE, ns_ev, ns_ev_net, us(idle_min), us(lmax), cst, clen / RES_SIZE, us(ct));
+    let pass = bit_exact && contained;
+    kprint!(" [P-neuro] {} — el0-neuro inside heqk: golden bit-exact={} fault-contained={}\n", if pass { "PASS" } else { "FAIL" }, bit_exact, contained);
+    pass
