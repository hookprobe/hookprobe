---
/**
 * Shell — HTML document wrapper.
 *
 * Provides: <html>, <head> (charset, viewport, meta, CSS import), <body>.
 * JS is supplied by the page's Solid client:only island (browser-rendered; no prerendered markup, ~60 KB gz less in the device image), which renders the global AppShell
 * (top bar, rail, Sample-data banner, Copilot, phone tabs).
 */

import '../styles/global.css';
import '../styles/shell.css';
import '../styles/layer0.css';
import '../styles/pro.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title       = 'Mission Control — HookProbe OS',
  description = 'HookProbe OS V2: the operating system. SOC is its default workspace. Hardware only unlocks capabilities.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Dark mode only; never flash white -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0f" />
    <title>{title}</title>
    <!-- Favicon: minimal HookProbe glyph -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <noscript><p style="padding:24px;font:16px system-ui">Mission Control needs JavaScript. Turn it on for this device's address and reload.</p></noscript>
    <slot />
  </body>
</html>
