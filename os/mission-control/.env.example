# Device API base URL, read at BUILD time (Vite/Astro inlines `PUBLIC_*` vars into the static
# bundle — there is no server-side runtime to read this from).
#
# - Default (unset): same-origin. heqk serves the UI and the API from one origin; release and CI
#   builds set PUBLIC_API_BASE='' explicitly.
# - Local dev (Astro dev server on :4321): point it at a heqk device or QEMU instance, e.g.
#
# PUBLIC_API_BASE=https://<device-address>

# AI planner base URL (ADR 0025), same build-time-inlined convention. Unset = same-origin: heqk
# serves `/api/planner/*` itself (today it answers `configured: false`). Set it only to use a
# planner on a separate origin.
#
# PUBLIC_PLANNER_API_BASE=
