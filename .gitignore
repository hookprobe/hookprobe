target/
node_modules/
ui/dist/
builder/kernel-build/build-*/
builder/kernel-build/debroot-*/
builder/kernel-build/linux-*/
builder/kernel-build/*.deb
builder/kernel-build/*.tar.gz
builder/mkosi*/*.img
builder/mkosi*/*.raw
builder/mkosi*/*.efi
builder/mkosi*/*.initrd
builder/mkosi*/*.vmlinuz
builder/mkosi*/pi-kernel-cache/
*.orig
*.old

# ADR 0043 M1: heqk build-seam staging output
builder/generated/

# Product-Cortex RUNTIME telemetry — logs session/transcript content (user prompts,
# agent summaries) + a 4MB lifecycle SQLite DB. MUST NOT be in a public repo (it
# captured the scrubbed dev credential via an agent report). Keep .claude/agents,
# .claude/workflows, .claude/hooks, .claude/settings.json — those are project canon.
.claude/cortex/
.claude/**/*.db
.claude/**/*.db-journal

# ── ADR 0044 / Phase-0 GitHub-prep hardening (2026-07-25) ─────────────────────
# History was purged with git-filter-repo (2026-07-25): builder/release.key*, the
# kernel-build .deb bloat, .claude/cortex/ telemetry, and a personal dev credential
# (both the operator username and a hardcoded wifi password) are gone from ALL
# commits — including the inherited HEQK history (verified clean). These rules keep
# them from ever re-entering the tree.
#
# Secrets / private key material — MUST NEVER be tracked (defense-in-depth; the
# committed signing keys were purged from history — production signs via HSM/keyless).
builder/release.key
builder/release.key*
*.key
!**/*.pub
!**/*public*.pem
cosign.key
*.sk
*.pem
!kernel/heqk/tools/usbboot/secure-boot-example/*.pem   # upstream usbboot PUBLIC example (gitleaks-allowlist); drop if unused
.env
!ui/.env.example
.netrc
id_rsa
id_ed25519
id_ecdsa

# Build-artifact catch-alls (path-scoped rules above stay authoritative; these are
# defense-in-depth for the whole tree — e.g. a stray backup tarball like
# heqk-git-history-backup-*.tar.gz must never be added).
builder/kernel-build/out/
*.img
*.raw
*.qcow2
*.tar.gz
!base/drivers/**/*.tar.gz          # pinned vendored-driver sources (base/drivers/SOURCES.md) are legitimate

# heqk dev boot-signing keydir (builder/gen-heqk-dev-keys.sh) — private key material, never tracked
builder/.heqk-dev-keys/
