# /etc/superpop/superpop.env — host-specific settings for superpop.service (copy, then fill in; mode 0640).
# SUPERPOP_BIND:   the host's private address that receives UDP 7654/7655 (0.0.0.0 = all addresses)
# SUPERPOP_WAN_IF: the interface tunnelled traffic is NATed out of
# SUPERPOP_TENANT: the tenant id (hex, u64) carried in msg2; use a dedicated TEST tenant, never a real one
# SUPERPOP_POOL:   the inner address pool; 198.18.0.0/15 (RFC 2544) collides with nothing routable
# SUPERPOP_GW:     the PoP's own address inside the pool
SUPERPOP_BIND=0.0.0.0
SUPERPOP_WAN_IF=eth0
SUPERPOP_TUN=hqpop0
SUPERPOP_TENANT=53315f54455354
SUPERPOP_POOL=198.18.0.0/15
SUPERPOP_GW=198.18.0.1
