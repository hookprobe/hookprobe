# superpop.service — the G19 super-PoP (a test tenant) on a Linux host that also runs other services.
# Install: see deploy/S0-RUNBOOK.md. Operator-applied (Red); nothing here is applied automatically.
#
# Every host-specific value (bind address, WAN interface, tenant, pool) lives in /etc/superpop/superpop.env
# (template: deploy/superpop.env.example). Nothing about a particular host is baked into this unit.
# Budget: one core (≤100%), 256 MiB. The PoP itself needs only CAP_NET_ADMIN, to create its TUN; host networking
# (address, NAT, MSS clamp) runs as root in ExecStartPost via superpop-net.sh.
[Unit]
Description=HookProbe G19 super-PoP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superpop
Group=superpop
EnvironmentFile=/etc/superpop/superpop.env
ExecStart=/usr/local/bin/superpop run --key-file /etc/superpop/pop.key --devices /etc/superpop/devices \
  --bind ${SUPERPOP_BIND} --tun ${SUPERPOP_TUN} --tenant ${SUPERPOP_TENANT} --pool ${SUPERPOP_POOL} \
  --ctr-state /var/lib/superpop/ctr.txt
# ADR 0069: the msg1 counter marks (durable; systemd creates /var/lib/superpop owned by the service user)
StateDirectory=superpop
StateDirectoryMode=0700
# '+' = runs as root outside the sandbox: wait for the TUN, then address/forwarding-check/NAT/MSS (superpop-net.sh).
ExecStartPost=+/bin/sh -c 'for i in $(seq 50); do ip link show "$SUPERPOP_TUN" >/dev/null 2>&1 && exec /usr/local/sbin/superpop-net.sh "$SUPERPOP_TUN" "$SUPERPOP_WAN_IF" "$SUPERPOP_POOL" "$SUPERPOP_GW"; sleep 0.1; done; echo "superpop: $SUPERPOP_TUN never appeared" >&2; exit 1'
ExecStopPost=-+/usr/sbin/nft delete table inet superpop
ExecStopPost=-+/usr/sbin/nft delete table ip superpop_nat
Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
# Pin to one core with a drop-in if the host needs it: [Service] AllowedCPUs=<n>
CPUQuota=100%
MemoryMax=256M
TasksMax=32
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/superpop
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
